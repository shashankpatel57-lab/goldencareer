0000, token);
            if (done.Code != 226)
                throw new IOException("Verification did not finish: " + done.Text);
        }

        static string Sha256File(
            string path,
            CancellationToken token,
            Action waitIfPaused)
        {
            using (var sha = SHA256.Create())
            using (var fs = new FileStream(
                path,
                FileMode.Open,
                FileAccess.Read,
                FileShare.Read,
                1024 * 1024,
                FileOptions.SequentialScan))
            {
                byte[] buf = new byte[1024 * 1024];
                int n;

                while ((n = fs.Read(buf, 0, buf.Length)) > 0)
                {
                    token.ThrowIfCancellationRequested();
                    if (waitIfPaused != null) waitIfPaused();
                    sha.TransformBlock(buf, 0, n, null, 0);
                }

                sha.TransformFinalBlock(new byte[0], 0, 0);
                return BitConverter.ToString(sha.Hash).Replace("-", "").ToLowerInvariant();
            }
        }

        static long SafePartLengthLocal(RemoteFile f)
        {
            try
            {
                if (!File.Exists(f.PartPath)) return 0;

                long n = new FileInfo(f.PartPath).Length;

                if (n < 0 || n > f.Size)
                {
                    File.Delete(f.PartPath);
                    return 0;
                }

                return n;
            }
            catch
            {
                return 0;
            }
        }

        static void FinalizeLocalFile(RemoteFile file)
        {
            long size = File.Exists(file.PartPath)
                ? new FileInfo(file.PartPath).Length
                : 0;

            if (size != file.Size)
                throw new IOException(
                    "Incomplete local file " +
                    size + "/" + file.Size);

            if (File.Exists(file.FinalPath))
                File.Delete(file.FinalPath);

            File.Move(file.PartPath, file.FinalPath);

            if (file.ModifiedUtc != DateTime.MinValue)
            {
                try
                {
                    File.SetLastWriteTimeUtc(
                        file.FinalPath,
                        file.ModifiedUtc);
                }
                catch { }
            }
        }

        public async Task DownloadAsync(
            string remotePath,
            string localPartPath,
            long expectedSize,
            long offset,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes)
        {
            EnsureConnected();

            if (packedActive)
                throw new IOException("Use packed batch transfer for XFD2");

            if (turboActive)
            {
                await DownloadPersistentTurboAsync(
                    remotePath,
                    localPartPath,
                    expectedSize,
                    offset,
                    bufferBytes,
                    token,
                    onBytes);
                return;
            }

            await DownloadStandardFtpAsync(
                remotePath,
                localPartPath,
                expectedSize,
                offset,
                bufferBytes,
                token,
                onBytes);
        }

        async Task DownloadPersistentTurboAsync(
            string remotePath,
            string localPartPath,
            long expectedSize,
            long offset,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes)
        {
            string encoded = Convert.ToBase64String(
                Encoding.UTF8.GetBytes(NormalizeRemote(remotePath)));

            await writer.WriteLineAsync(
                "GET " +
                offset.ToString(CultureInfo.InvariantCulture) +
                " 0 " +
                encoded);
            await writer.FlushAsync();

            var start = await ReadResponseAsync(15000, token);

            if (start.Code != 150)
                throw new IOException("Turbo GET failed: " + start.Text);

            string[] p = start.Text.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

            if (p.Length < 3)
                throw new IOException("Invalid Turbo header: " + start.Text);

            long length;
            long total;

            if (!long.TryParse(p[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out length) ||
                !long.TryParse(p[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out total))
                throw new IOException("Invalid Turbo file size header");

            if (total != expectedSize)
                throw new IOException("Phone file size changed: " + total + " / " + expectedSize);

            if (offset + length != expectedSize)
                throw new IOException("Unexpected Turbo range length");

            EnsureTransferBuffer(bufferBytes);

            Directory.CreateDirectory(Path.GetDirectoryName(localPartPath));

            using (var fs = new FileStream(
                localPartPath,
                FileMode.OpenOrCreate,
                FileAccess.Write,
                FileShare.Read,
                bufferBytes,
                FileOptions.SequentialScan))
            {
                fs.Seek(offset, SeekOrigin.Begin);

                if (fs.Length != offset)
                    fs.SetLength(offset);

                long got = 0;

                while (got < length)
                {
                    token.ThrowIfCancellationRequested();

                    int want = (int)Math.Min(transferBuffer.Length, length - got);
                    int n = await ReadWithTimeoutAsync(
                        stream,
                        transferBuffer,
                        0,
                        want,
                        20000,
                        token);

                    if (n <= 0)
                        throw new IOException("Turbo stream closed early");

                    fs.Write(transferBuffer, 0, n);
                    got += n;

                    if (onBytes != null)
                        onBytes(n);
                }
            }

            var finish = await ReadResponseAsync(12000, token);

            if (finish.Code != 226)
                throw new IOException("Turbo file did not finish: " + finish.Text);
        }

        async Task DownloadStandardFtpAsync(
            string remotePath,
            string localPartPath,
            long expectedSize,
            long offset,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes)
        {
            using (var data = await OpenPassiveAsync(token))
            {
                if (offset > 0)
                {
                    var rest = await CommandAsync(
                        "REST " + offset.ToString(CultureInfo.InvariantCulture),
                        token);
                    Expect(rest, 350);
                }

                string path = NormalizeRemote(remotePath);
                var start = await CommandAsync("RETR " + path, token);

                if (start.Code != 150 && start.Code != 125)
                    throw new IOException("Cannot download " + path + ": " + start.Text);

                data.ReceiveBufferSize = 4 * 1024 * 1024;
                data.NoDelay = true;

                EnsureTransferBuffer(bufferBytes);

                Directory.CreateDirectory(Path.GetDirectoryName(localPartPath));

                using (var fs = new FileStream(
                    localPartPath,
                    FileMode.OpenOrCreate,
                    FileAccess.Write,
                    FileShare.Read,
                    bufferBytes,
                    FileOptions.SequentialScan))
                {
                    fs.Seek(offset, SeekOrigin.Begin);

                    if (fs.Length != offset)
                        fs.SetLength(offset);

                    long got = offset;
                    Stream input = data.GetStream();

                    while (got < expectedSize)
                    {
                        token.ThrowIfCancellationRequested();

                        int want = (int)Math.Min(transferBuffer.Length, expectedSize - got);
                        int n = await ReadWithTimeoutAsync(
                            input,
                            transferBuffer,
                            0,
                            want,
                            20000,
                            token);

                        if (n <= 0) break;

                        fs.Write(transferBuffer, 0, n);
                        got += n;

                        if (onBytes != null)
                            onBytes(n);
                    }

                    if (got != expectedSize)
                        throw new IOException("Incomplete FTP file: " + got + " / " + expectedSize);
                }

                data.Close();

                var finish = await ReadResponseAsync(12000, token);

                if (finish.Code != 226 && finish.Code != 250)
                    throw new IOException("FTP transfer did not finish: " + finish.Text);
            }
        }

        void EnsureTransferBuffer(int bufferBytes)
        {
            int size = Math.Max(512 * 1024, Math.Min(8 * 1024 * 1024, bufferBytes));

            if (transferBuffer == null || transferBuffer.Length != size)
                transferBuffer = new byte[size];
        }

        async Task<TcpClient> OpenPassiveAsync(CancellationToken token)
        {
            var epsv = await CommandAsync("EPSV", token);
            int dataPort = 0;

            if (epsv.Code == 229)
            {
                int a = epsv.Text.IndexOf("(|||", StringComparison.Ordinal);
                int b = a >= 0
                    ? epsv.Text.IndexOf("|)", a + 4, StringComparison.Ordinal)
                    : -1;

                if (a >= 0 && b > a)
                {
                    string p = epsv.Text.Substring(a + 4, b - (a + 4));
                    int.TryParse(p, out dataPort);
                }
            }

            if (dataPort <= 0)
            {
                var pasv = await CommandAsync("PASV", token);
                Expect(pasv, 227);

                int l = pasv.Text.IndexOf('(');
                int r = pasv.Text.IndexOf(')', l + 1);

                if (l < 0 || r <= l)
                    throw new IOException("Invalid PASV response");

                string[] v = pasv.Text.Substring(l + 1, r - l - 1).Split(',');

                if (v.Length != 6)
                    throw new IOException("Invalid PASV response");

                int p1, p2;

                if (!int.TryParse(v[4], out p1) ||
                    !int.TryParse(v[5], out p2))
                    throw new IOException("Invalid PASV port");

                dataPort = p1 * 256 + p2;
            }

            var data = new TcpClient();
            data.NoDelay = true;
            data.ReceiveBufferSize = 4 * 1024 * 1024;

            await ConnectTcpAsync(data, host, dataPort, 6000, token);
            return data;
        }

        async Task<FtpResponse> CommandAsync(string command, CancellationToken token)
        {
            EnsureConnected();

            await writer.WriteLineAsync(command);
            await writer.FlushAsync();

            return await ReadResponseAsync(12000, token);
        }

        async Task<FtpResponse> ReadResponseAsync(int timeoutMs, CancellationToken token)
        {
            string first = await ReadLineRawAsync(stream, timeoutMs, token);

            if (string.IsNullOrEmpty(first))
                throw new IOException("FTP control connection closed");

            if (first.Length < 3)
                throw new IOException("Invalid FTP response: " + first);

            int code;

            if (!int.TryParse(first.Substring(0, 3), out code))
                throw new IOException("Invalid FTP response: " + first);

            var all = new StringBuilder(first);

            if (first.Length > 3 && first[3] == '-')
            {
                string terminator =
                    code.ToString(CultureInfo.InvariantCulture) + " ";

                while (true)
                {
                    string line = await ReadLineRawAsync(stream, timeoutMs, token);

                    if (line == null)
                        throw new IOException("FTP control connection closed");

                    all.Append("\n").Append(line);

                    if (line.StartsWith(terminator, StringComparison.Ordinal))
                        break;
                }
            }

            return new FtpResponse { Code = code, Text = all.ToString() };
        }

        static async Task<string> ReadLineRawAsync(
            Stream input,
            int timeoutMs,
            CancellationToken token)
        {
            var bytes = new List<byte>(128);
            byte[] one = new byte[1];

            while (bytes.Count < 64 * 1024)
            {
                int n = await ReadWithTimeoutAsync(
                    input, one, 0, 1, timeoutMs, token);

                if (n <= 0)
                {
                    if (bytes.Count == 0) return null;
                    break;
                }

                if (one[0] == 10) break;
                if (one[0] != 13) bytes.Add(one[0]);
            }

            return Encoding.UTF8.GetString(bytes.ToArray());
        }

        static async Task<int> ReadWithTimeoutAsync(
            Stream input,
            byte[] buffer,
            int offset,
            int count,
            int timeoutMs,
            CancellationToken token)
        {
            var task = input.ReadAsync(buffer, offset, count, token);
            var winner = await Task.WhenAny(task, Task.Delay(timeoutMs, token));

            if (winner != task)
            {
                token.ThrowIfCancellationRequested();
                throw new IOException(
                    "No data received for " +
                    (timeoutMs / 1000) +
   