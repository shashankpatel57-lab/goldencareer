n sr.ReadToEnd();
            },token);
        }

        async Task OpenSelectedAsync()
        {
            if(remoteList.SelectedItems.Count==0)return;
            var x=remoteList.SelectedItems[0].Tag as PhoneItem;
            if(x!=null && x.dir) await LoadFolderAsync(x.path);
        }

        async Task UpAsync()
        {
            if(string.IsNullOrEmpty(currentPath)){await LoadFolderAsync("");return;}
            var p=currentPath.Replace('\\','/'); int i=p.LastIndexOf('/'); p=i<0?"":p.Substring(0,i); await LoadFolderAsync(p);
        }

        void ChooseFolder()
        {
            using(var f=new FolderBrowserDialog { Description="Choose where FlashDrop should save the phone folder", ShowNewFolderButton=true, SelectedPath=Directory.Exists(localBox.Text)?localBox.Text:"" })
                if(f.ShowDialog(this)==DialogResult.OK)localBox.Text=f.SelectedPath;
        }

        void OpenDestination()
        {
            try{Directory.CreateDirectory(localBox.Text);Process.Start("explorer.exe",localBox.Text);}catch(Exception ex){SetStatus(ex.Message,true);}
        }

        async Task StartTransferAsync()
        {
            if(cts!=null)return;
            if(Pin.Length!=6){SetStatus("Enter the PIN and connect first.",true);return;}
            if(string.IsNullOrWhiteSpace(localBox.Text)){SetStatus("Choose a destination folder on the PC.",true);return;}

            cts=new CancellationTokenSource();
            var token=cts.Token;
            startBtn.Enabled=false;
            cancelBtn.Enabled=true;
            ToggleConnect(false);
            completedBytes=0;
            totalBytes=0;
            progress.Value=0;
            transferWatch=null;
            speedTimer.Stop();

            try
            {
                compatibilityFtpMode=false;
                SetStatus("Testing direct Turbo path…",false);

                try
                {
                    double link=await RunTurboBenchmarkAsync(8L*1024L*1024L,token);
                    SetStatus("Raw Turbo available: "+link.ToString("0.0")+" MB/s. Scanning selected phone folder…",false);
                }
                catch(Exception)
                {
                    compatibilityFtpMode=true;
                    SetStatus("OnePlus / compatibility mode selected automatically. Using parallel local FTP Turbo path…",false);
                }

                var remoteRoot=currentPath??"";
                string rootName=string.IsNullOrEmpty(remoteRoot)?"PhoneBackup":Sanitize(RemoteLeaf(remoteRoot));
                string destination=Path.Combine(localBox.Text,rootName);
                Directory.CreateDirectory(destination);

                var files=new List<RemoteFile>();
                await BuildManifestAsync(remoteRoot,"",destination,files,token);
                totalBytes=files.Sum(f=>f.Size);
                totalLabel.Text=files.Count+" files • "+FormatBytes(totalBytes);
                if(files.Count==0){SetStatus("No readable files found in this folder.",true);return;}

                int workers=(int)workersBox.Value;
                var jobs=new ConcurrentQueue<RemoteFile>();
                long alreadyDone=0;

                foreach(var f in files)
                {
                    token.ThrowIfCancellationRequested();
                    Directory.CreateDirectory(Path.GetDirectoryName(f.FinalPath));

                    if(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size)
                    {
                        alreadyDone+=f.Size;
                        continue;
                    }

                    if(f.Size==0)
                    {
                        File.WriteAllBytes(f.FinalPath,new byte[0]);
                        continue;
                    }

                    long partial=0;
                    try
                    {
                        if(File.Exists(f.PartPath))
                        {
                            partial=new FileInfo(f.PartPath).Length;
                            if(partial<0 || partial>f.Size)
                            {
                                File.Delete(f.PartPath);
                                partial=0;
                            }
                        }
                    }
                    catch
                    {
                        partial=0;
                    }

                    alreadyDone+=partial;
                    jobs.Enqueue(f);
                }

                Interlocked.Exchange(ref completedBytes,alreadyDone);
                if(jobs.IsEmpty)
                {
                    SetStatus("Everything is already present at the destination.",false);
                    progress.Value=1000;
                    return;
                }

                transferWatch=Stopwatch.StartNew();
                speedSampleBytes=Interlocked.Read(ref completedBytes);
                speedSampleAt=DateTime.UtcNow;
                smoothedMbps=0;
                speedTimer.Start();

                SetStatus(
                    compatibilityFtpMode
                        ? "Compatibility Turbo running — "+workers+" parallel FTP lanes • resume enabled."
                        : "Adaptive Turbo v1.8 running — "+workers+" persistent raw lanes • RAM write-ahead buffering.",
                    false);

                var errors=new ConcurrentQueue<string>();
                var tasks=new List<Task>();

                for(int i=0;i<workers;i++)
                {
                    tasks.Add(Task.Run(async()=>{
                        using(var session=new TurboSession(TurboHost,TurboPort,Pin))
                        {
                            RemoteFile file;

                            while(!token.IsCancellationRequested && jobs.TryDequeue(out file))
                            {
                                bool ok=false;
                                Exception last=null;

                                for(int attempt=1;attempt<=4 && !ok && !token.IsCancellationRequested;attempt++)
                                {
                                    try
                                    {
                                        if(compatibilityFtpMode)
                                            await DownloadFileFtpAsync(file,token);
                                        else
                                            await DownloadFileTurboAsync(file,session,token);
                                        ok=true;
                                    }
                                    catch(Exception ex)
                                    {
                                        last=ex;
                                        session.Close();
                                        Thread.Sleep(250*attempt);
                                    }
                                }

                                if(!ok)
                                {
                                    errors.Enqueue(file.RemotePath+" : "+(last==null?"transfer failed":last.Message));
                                    continue;
                                }

                                try
                                {
                                    long got=File.Exists(file.PartPath)?new FileInfo(file.PartPath).Length:0;
                                    if(got!=file.Size)throw new IOException("Incomplete file "+got+"/"+file.Size);

                                    if(File.Exists(file.FinalPath))File.Delete(file.FinalPath);
                                    File.Move(file.PartPath,file.FinalPath);

                                    if(file.Modified>0)
                                        File.SetLastWriteTime(
                                            file.FinalPath,
                                            DateTimeOffset.FromUnixTimeMilliseconds(file.Modified).LocalDateTime);
                                }
                                catch(Exception ex)
                                {
 