, 0, 10);
            outer.Controls.Add(destCard, 0, 3);

            var d = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 5,
                RowCount = 2,
                Padding = new Padding(14, 10, 14, 10),
                BackColor = Color.White
            };
            d.RowStyles.Add(new RowStyle(SizeType.Absolute, 28));
            d.RowStyles.Add(new RowStyle(SizeType.Percent, 100));
            d.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
            d.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 130));
            d.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 120));
            d.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 190));
            d.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 115));
            destCard.Controls.Add(d);

            d.Controls.Add(LabelX("DESTINATION ON THIS PC", 9, Muted, true), 0, 0);
            var note = LabelX("4 persistent workers / 2 MB buffer recommended for OnePlus", 8.8f, Muted, false);
            note.Dock = DockStyle.Fill;
            note.TextAlign = ContentAlignment.MiddleRight;
            d.SetColumnSpan(note, 4);
            d.Controls.Add(note, 1, 0);

            localBox = Box();
            localBox.Text = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "FlashDrop");
            d.Controls.Add(localBox, 0, 1);

            browseBtn = Btn("CHOOSE FOLDER", Color.FromArgb(229, 248, 241), Green);
            browseBtn.Click += (s, e) => ChooseFolder();
            d.Controls.Add(browseBtn, 1, 1);

            openBtn = Btn("OPEN FOLDER", Color.FromArgb(240, 244, 250), Ink);
            openBtn.Click += (s, e) => OpenDestination();
            d.Controls.Add(openBtn, 2, 1);

            startBtn = Btn("START TURBO COPY", Green, Color.White);
            startBtn.Font = new Font("Segoe UI", 10f, FontStyle.Bold);
            startBtn.Click += async (s, e) => await StartTransferAsync();
            d.Controls.Add(startBtn, 3, 1);

            cancelBtn = Btn("CANCEL", Color.FromArgb(255, 236, 238), Color.FromArgb(185, 45, 55));
            cancelBtn.Enabled = false;
            cancelBtn.Click += (s, e) => { if (transferCts != null) transferCts.Cancel(); };
            d.Controls.Add(cancelBtn, 4, 1);

            var bottom = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 3,
                RowCount = 2,
                Padding = new Padding(2, 8, 2, 0),
                BackColor = Bg
            };
            bottom.RowStyles.Add(new RowStyle(SizeType.Absolute, 28));
            bottom.RowStyles.Add(new RowStyle(SizeType.Percent, 100));
            bottom.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
            bottom.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 150));
            bottom.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 235));
            outer.Controls.Add(bottom, 0, 4);

            progress = new ProgressBar
            {
                Dock = DockStyle.Fill,
                Style = ProgressBarStyle.Continuous,
                Maximum = 1000,
                Margin = new Padding(0, 3, 0, 5)
            };
            bottom.SetColumnSpan(progress, 3);
            bottom.Controls.Add(progress, 0, 0);

            statusLabel = LabelX("Ready. Turbo 3.1 uses persistent XFD1 streams on the proven FTP port.", 9.5f, Muted, false);
            statusLabel.Dock = DockStyle.Fill;
            statusLabel.TextAlign = ContentAlignment.MiddleLeft;
            statusLabel.AutoEllipsis = true;
            bottom.Controls.Add(statusLabel, 0, 1);

            speedLabel = LabelX("0.0 MB/s", 12, Blue, true);
            speedLabel.Dock = DockStyle.Fill;
            speedLabel.TextAlign = ContentAlignment.MiddleRight;
            bottom.Controls.Add(speedLabel, 1, 1);

            totalLabel = LabelX("Waiting to transfer", 9, Muted, false);
            totalLabel.Dock = DockStyle.Fill;
            totalLabel.TextAlign = ContentAlignment.MiddleRight;
            totalLabel.AutoEllipsis = true;
            bottom.Controls.Add(totalLabel, 2, 1);

            speedTimer = new System.Windows.Forms.Timer { Interval = 1000 };
            speedTimer.Tick += (s, e) => UpdateSpeed();
        }

        async Task AutoDetectAsync()
        {
            detectBtn.Enabled = false;
            SetStatus("Detecting FlashDrop FTP on the hotspot...", false);

            try
            {
                var hosts = new List<string>();

                foreach (var ni in NetworkInterface.GetAllNetworkInterfaces())
                {
                    if (ni.OperationalStatus != OperationalStatus.Up) continue;

                    try
                    {
                        foreach (var g in ni.GetIPProperties().GatewayAddresses)
                        {
                            if (g.Address.AddressFamily == AddressFamily.InterNetwork)
                            {
                                string h = g.Address.ToString();
                                if (!hosts.Contains(h)) hosts.Add(h);
                            }
                        }
                    }
                    catch { }
                }

                string typed = ExtractHost(addressBox.Text);
                if (!string.IsNullOrEmpty(typed) && !hosts.Contains(typed)) hosts.Insert(0, typed);

                string[] common = { "192.168.43.1", "192.168.1.1", "192.168.80.1", "192.168.137.1", "172.20.10.1" };
                foreach (var h in common) if (!hosts.Contains(h)) hosts.Add(h);

                FtpEndpoint found = null;

                foreach (string host in hosts)
                {
                    for (int port = 2121; port <= 2130; port++)
                    {
                        if (await ProbeFtpAsync(host, port, 500))
                        {
                            found = new FtpEndpoint { Host = host, Port = port };
                            break;
                        }
                    }
                    if (found != null) break;
                }

                if (found == null)
                {
                    SetStatus("Could not auto-detect. Copy the FTP address shown in the Android app and paste it above.", true);
                    return;
                }

                endpoint = found;
                addressBox.Text = found.ToString();
                SetStatus("FlashDrop found at " + found, false);
                await LoadFolderAsync("/");
            }
            catch (Exception ex)
            {
                SetStatus("Detection error: " + ex.Message, true);
            }
            finally
            {
                detectBtn.Enabled = true;
            }
        }

        async Task ConnectAndLoadAsync()
        {
            try
            {
                endpoint = await ResolveEndpointAsync(addressBox.Text);
                if (endpoint == null) throw new IOException("FTP server not found on this phone");
                addressBox.Text = endpoint.ToString();
                await LoadFolderAsync("/");
            }
            catch (Exception ex)
            {
                connectionLabel.Text = "Connection failed";
                connectionLabel.ForeColor = Color.Firebrick;
                SetStatus(ex.Message, true);
            }
        }

        async Task LoadFolderAsync(string path)
        {
            if (endpoint == null)
            {
                endpoint = await ResolveEndpointAsync(addressBox.Text);
                if (endpoint == null) throw new IOException("Connect to the phone first");
            }

            ToggleConnect(false);

            try
            {
                List<FtpItem> items;

                using (var ftp = new FtpSession(endpoint.Host, endpoint.Port, false))
                {
                    await ftp.ConnectAsync(CancellationToken.None);
                    items = await ftp.ListAsync(path, CancellationToken.None);
                }

                currentPath = NormalizeRemote(path);
                pathLabel.Text = currentPath == "/" ? "Internal storage" : "Internal storage " + currentPath;
                remoteList.Items.Clear();

                foreach (var x in items)
                {
                    var li = new ListViewItem(x.Name);
                    li.Tag = x;
                    li.SubItems.Add(x.IsDirectory ? "Folder" : "File");
                    li.SubItems.Add(x.IsDirectory ? "—" : FormatBytes(x.Size));
                    li.SubItems.Add(x.ModifiedUtc == DateTime.MinValue ? "—" : x.ModifiedUtc.ToLocalTime().ToString("g"));

                    if (x.IsDirectory)
                    {
                        li.ForeColor = Color.FromArgb(32, 74, 156);
                        li.Font = new Font(remoteList.Font, FontStyle.Bold);
                    }

                    remoteList.Items.Add(li);
                }

                connectionLabel.Text = "FTP connected";
                connectionLabel.ForeColor = Green;
                SetStatus("Connected through the stable FTP engine. Double-click a folder or start copying the current folder tree.", false);
            }
            finally
            {
                ToggleConnect(true);
            }
        }

        async Task OpenSelectedAsync()
        {
            if (remoteList.SelectedItems.Count == 0) return;
            var x = remoteList.SelectedItems[0].Tag as FtpItem;
            if (x != null && x.IsDirectory) await LoadFolderAsync(x.FullPath);
        }

        async Task UpAsync()
        {
            string p = NormalizeRemote(currentPath);
            if (p == "/") { await LoadFolderAsync("/"); return; }

            p = p.TrimEnd('/');
            int i = p.LastIndexOf('/');
            p = i <= 0 ? "/" : p.Substring(0, i);
            await LoadFolderAsync(p);
        }

