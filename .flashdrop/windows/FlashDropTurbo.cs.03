ateDirectory(Path.GetDirectoryName(f.FinalPath));

                    if(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size)
                    {
                        alreadyDone+=f.Size;
                        continue;
                    }

                    if(f.Size==0)
                    {
                        File.WriteAllBytes(f.FinalPath,new byte[0]);
                        continue;
                    }

                    long partial=0;

                    try
                    {
                        if(File.Exists(f.PartPath))
                        {
                            partial=new FileInfo(f.PartPath).Length;

                            if(partial<0 || partial>f.Size)
                            {
                                File.Delete(f.PartPath);
                                partial=0;
                            }
                        }
                    }
                    catch
                    {
                        partial=0;
                    }

                    alreadyDone+=partial;
                    pending.Add(f);
                }

                Interlocked.Exchange(ref completedBytes,alreadyDone);

                if(pending.Count==0)
                {
                    SetStatus("Everything is already present at the destination.",false);
                    progress.Value=1000;
                    return;
                }

                int laneCount=Math.Max(1,Math.Min((int)workersBox.Value,pending.Count));
                var lanes=new List<List<RemoteFile>>();
                var laneLoads=new long[laneCount];

                for(int i=0;i<laneCount;i++)lanes.Add(new List<RemoteFile>());

                foreach(var f in pending.OrderByDescending(x=>RemainingBytes(x)))
                {
                    int best=0;
                    for(int i=1;i<laneCount;i++)
                        if(laneLoads[i]<laneLoads[best])best=i;

                    lanes[best].Add(f);
                    laneLoads[best]+=RemainingBytes(f);
                }

                transferWatch=Stopwatch.StartNew();
                speedSampleBytes=Interlocked.Read(ref completedBytes);
                speedSampleAt=DateTime.UtcNow;
                smoothedMbps=0;
                speedTimer.Start();

                SetStatus(
                    "Universal Turbo v2.1 running — "+laneCount+
                    " adaptive HTTP lanes on "+new Uri(BaseUrl).Port+
                    " • automatic protocol fallback.",
                    false);

                var errors=new ConcurrentQueue<string>();
                var tasks=new List<Task>();

                foreach(var lane in lanes)
                {
                    var captured=lane;
                    tasks.Add(Task.Run(async()=>{
                        try
                        {
                            await DownloadBundleLaneAsync(captured,token,errors);
                        }
                        catch(OperationCanceledException){throw;}
                        catch(Exception ex)
                        {
                            errors.Enqueue("Lane stopped: "+ex.Message);
                        }
                    },token));
                }

                await Task.WhenAll(tasks);
                token.ThrowIfCancellationRequested();

                long finished=files.Sum(f=>
                    File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size ? f.Size :
                    (File.Exists(f.PartPath)?Math.Min(f.Size,new FileInfo(f.PartPath).Length):0));

                Interlocked.Exchange(ref completedBytes,finished);
                UpdateSpeed();

                if(errors.IsEmpty && finished>=totalBytes)
                {
                    progress.Value=1000;
                    SetStatus("DONE — "+files.Count+" files copied to "+destination,false);
                }
                else
                {
                    SetStatus(
                        "Transfer finished with "+errors.Count+
                        " issue(s). Partial files are preserved; press Start again to resume. "+
                        (errors.IsEmpty?"":errors.FirstOrDefault()),
                        true);
                }
            }
            catch(OperationCanceledException)
            {
                SetStatus("Transfer cancelled. Partial files are kept and will resume next time.",true);
            }
            catch(Exception ex)
            {
                SetStatus("Transfer stopped: "+ex.Message+"  Partial files are preserved for resume.",true);
            }
            finally
            {
                speedTimer.Stop();
                if(transferWatch!=null)transferWatch.Stop();
                cts.Dispose();
                cts=null;
                startBtn.Enabled=true;
                cancelBtn.Enabled=false;
                ToggleConnect(true);
            }
        }

        long RemainingBytes(RemoteFile f)
        {
            if(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size)return 0;

            long partial=0;
            try
            {
                if(File.Exists(f.PartPath))partial=Math.Min(f.Size,new FileInfo(f.PartPath).Length);
            }
            catch{}

            return Math.Max(0,f.Size-partial);
        }

        async Task BuildManifestAsync(string remote,string rel,string destRoot,List<RemoteFile> files,CancellationToken token)
        {
            token.ThrowIfCancellationRequested();
            var list=await GetListAsync(remote,token);

            foreach(var x in (list.items??new PhoneItem[0]))
            {
                token.ThrowIfCancellationRequested();

                string original=Sanitize(x.name);
                string safe=CompactComponent(original,72);
                string childRel=string.IsNullOrEmpty(rel)?safe:Path.Combine(rel,safe);

                string candidate=Path.Combine(destRoot,childRel);

                if(candidate.Length>205)
                {
                    string compact="_"+Hash8(x.path)+"_"+CompactComponent(original,44);
                    childRel=Path.Combine("_LongPaths",compact);
                    candidate=Path.Combine(destRoot,childRel);
                }

                if(candidate.Length>225)
                {
                    string compact="_"+Hash8(x.path)+"_"+CompactComponent(original,24);
                    childRel=Path.Combine("_LP",compact);
                    candidate=Path.Combine(destRoot,childRel);
                }

                if(x.dir)
                {
                    Directory.CreateDirectory(candidate);
                    await BuildManifestAsync(x.path,childRel,destRoot,files,token);
                }
                else
                {
                    files.Add(new RemoteFile{
                        RemotePath=x.path,
                        RelativePath=childRel,
                        Size=Math.Max(0,x.size),
                        Modified=x.modified,
                        FinalPath=candidate,
                        PartPath=candidate+".flashdrop.part"
                    });
                }
            }
        }

        static string CompactComponent(string name,int max)
        {
            if(string.IsNullOrEmpty(name))return "unnamed";
            if(max<18)max=18;
            if(name.Length<=max)return name;

            string ext="";
            string stem=name;

            try
            {
                ext=Path.GetExtension(name);
                if(ext.Length>12)ext="";
                if(!string.IsNullOrEmpty(ext))stem=name.Substring(0,name.Length-ext.Length);
            }
            catch
            {
                ext="";
                stem=name;
            }

            string hash=Hash8(name);
            int keep=Math.Max(6,max-hash.Length-ext.Length-2);

            if(stem.Length>keep)stem=stem.Substring(0,keep);

            return stem+"_"+hash+ext;
        }

        static string Hash8(string s)
        {
            unchecked
            {
                uint h=2166136261;

                foreach(char c in (s??""))
                {
                    h^=c;
                    h*=16777619;
                }

                return h.ToString("x8");
            }
        }

