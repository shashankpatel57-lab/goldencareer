=null && x.dir) await LoadFolderAsync(x.path);
        }

        async Task UpAsync()
        {
            if(string.IsNullOrEmpty(currentPath)){await LoadFolderAsync("");return;}
            var p=currentPath.Replace('\\','/'); int i=p.LastIndexOf('/'); p=i<0?"":p.Substring(0,i); await LoadFolderAsync(p);
        }

        void ChooseFolder()
        {
            using(var f=new FolderBrowserDialog { Description="Choose where FlashDrop should save the phone folder", ShowNewFolderButton=true, SelectedPath=Directory.Exists(localBox.Text)?localBox.Text:"" })
                if(f.ShowDialog(this)==DialogResult.OK)localBox.Text=f.SelectedPath;
        }

        void OpenDestination()
        {
            try{Directory.CreateDirectory(localBox.Text);Process.Start("explorer.exe",localBox.Text);}catch(Exception ex){SetStatus(ex.Message,true);}
        }

        async Task StartTransferAsync()
        {
            if(cts!=null)return;
            if(Pin.Length!=6){SetStatus("Enter the PIN and connect first.",true);return;}
            if(string.IsNullOrWhiteSpace(localBox.Text)){SetStatus("Choose a destination folder on the PC.",true);return;}

            cts=new CancellationTokenSource();
            var token=cts.Token;
            startBtn.Enabled=false;
            cancelBtn.Enabled=true;
            ToggleConnect(false);
            completedBytes=0;
            totalBytes=0;
            progress.Value=0;
            transferWatch=null;
            speedTimer.Stop();

            try
            {
                SetStatus("Testing the same HTTP path used for browsing…",false);
                double link=await RunHttpBenchmarkAsync(16L*1024L*1024L,token);
                SetStatus("Unified LAN path: "+link.ToString("0.0")+" MB/s. Scanning selected phone folder…",false);

                var remoteRoot=currentPath??"";
                string rootName=string.IsNullOrEmpty(remoteRoot)?"PhoneBackup":Sanitize(RemoteLeaf(remoteRoot));
                string destination=Path.Combine(localBox.Text,rootName);
                Directory.CreateDirectory(destination);

                var files=new List<RemoteFile>();
                await BuildManifestAsync(remoteRoot,"",destination,files,token);
                totalBytes=files.Sum(f=>f.Size);
                totalLabel.Text=files.Count+" files • "+FormatBytes(totalBytes);

                if(files.Count==0)
                {
                    SetStatus("No readable files found in this folder.",true);
                    return;
                }

                long alreadyDone=0;
                var pending=new List<RemoteFile>();

                foreach(var f in files)
                {
                    token.ThrowIfCancellationRequested();
                    Directory.CreateDirectory(Path.GetDirectoryName(f.FinalPath));

                    if(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size)
                    {
                        alreadyDone+=f.Size;
                        continue;
                    }

                    if(f.Size==0)
                    {
                        File.WriteAllBytes(f.FinalPath,new byte[0]);
                        continue;
                    }

                    long partial=0;

                    try
                    {
                        if(File.Exists(f.PartPath))
                        {
                            partial=new FileInfo(f.PartPath).Length;

                            if(partial<0 || partial>f.Size)
                            {
                                File.Delete(f.PartPath);
                                partial=0;
                            }
                        }
                    }
                    catch
                    {
                        partial=0;
                    }

                    alreadyDone+=partial;
                    pending.Add(f);
                }

                Interlocked.Exchange(ref completedBytes,alreadyDone);

                if(pending.Count==0)
                {
                    SetStatus("Everything is already present at the destination.",false);
                    progress.Value=1000;
                    return;
                }

                int laneCount=Math.Max(1,Math.Min((int)workersBox.Value,pending.Count));
                var lanes=new List<List<RemoteFile>>();
                var laneLoads=new long[laneCount];

                for(int i=0;i<laneCount;i++)lanes.Add(new List<RemoteFile>());

                foreach(var f in pending.OrderByDescending(x=>RemainingBytes(x)))
                {
                    int best=0;
                    for(int i=1;i<laneCount;i++)
                        if(laneLoads[i]<laneLoads[best])best=i;

                    lanes[best].Add(f);
                    laneLoads[best]+=RemainingBytes(f);
                }

                transferWatch=Stopwatch.StartNew();
                speedSampleBytes=Interlocked.Read(ref completedBytes);
                speedSampleAt=DateTime.UtcNow;
                smoothedMbps=0;
                speedTimer.Start();

                SetStatus(
                    "Unified Turbo v2.0 running — "+laneCount+
                    " continuous HTTP bundle lanes on "+new Uri(BaseUrl).Port+
                    " • no per-file reconnects.",
                    false);

                var errors=new ConcurrentQueue<string>();
                var tasks=new List<Task>();

                foreach(var lane in lanes)
                {
                    var captured=lane;
                    tasks.Add(Task.Run(async()=>{
                        try
                        {
                            await DownloadBundleLaneAsync(captured,token,errors);
                        }
                        catch(OperationCanceledException){throw;}
                        catch(Exception ex)
                        {
                            errors.Enqueue("Lane stopped: "+ex.Message);
                        }
                    },token));
                }

                await Task.WhenAll(tasks);
                token.ThrowIfCancellationRequested();

                long finished=files.Sum(f=>
                    File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size ? f.Size :
                    (File.Exists(f.PartPath)?Math.Min(f.Size,new FileInfo(f.PartPath).Length):0));

                Interlocked.Exchange(ref completedBytes,finished);
                UpdateSpeed();

                if(errors.IsEmpty && finished>=totalBytes)
                {
                    progress.Value=1000;
                    SetStatus("DONE — "+files.Count+" files copied to "+destination,false);
                }
                else
                {
                    SetStatus(
                        "Transfer finished with "+errors.Count+
                        " issue(s). Partial files are preserved; press Start again to resume. "+
                        (errors.IsEmpty?"":errors.FirstOrDefault()),
                        true);
                }
            }
            catch(OperationCanceledException)
            {
                SetStatus("Transfer cancelled. Partial files are kept and will resume next time.",true);
            }
            catch(Exception ex)
            {
                SetStatus("Transfer stopped: "+ex.Message+"  Partial files are preserved for resume.",true);
            }
            finally
            {
                speedTimer.Stop();
                if(transferWatch!=null)transferWatch.Stop();
                cts.Dispose();
                cts=null;
                startBtn.Enabled=true;
                cancelBtn.Enabled=false;
                ToggleConnect(true);
            }
        }

        long RemainingBytes(RemoteFile f)
        {
            if(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size)return 0;

            long partial=0;
            try
            {
                if(File.Exists(f.PartPath))partial=Math.Min(f.Size,new FileInfo(f.PartPath).Length);
            }
            catch{}

            re