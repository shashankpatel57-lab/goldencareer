namespace FlashDropTurbo
{
    static class Program
    {
        [STAThread]
        static void Main()
        {
            ServicePointManager.DefaultConnectionLimit = 64;
            ServicePointManager.Expect100Continue = false;
            ServicePointManager.UseNagleAlgorithm = false;
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }

    sealed class HeroPanel : Panel
    {
        public Color A = Color.FromArgb(53, 62, 246);
        public Color B = Color.FromArgb(9, 180, 154);
        public HeroPanel() { DoubleBuffered = true; }
        protected override void OnPaintBackground(PaintEventArgs e)
        {
            using (var br = new LinearGradientBrush(ClientRectangle, A, B, 18f)) e.Graphics.FillRectangle(br, ClientRectangle);
        }
    }

    sealed class PhoneItem
    {
        public string name { get; set; }
