using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Diagnostics;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.NetworkInformation;
using System.Net.Sockets;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace FlashDropTurbo
{
    static class Program
    {
        [STAThread]
        static void Main()
        {
            ServicePointManager.DefaultConnectionLimit = 64;
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }

    sealed class HeroPanel : Panel
    {
        public Color A = Color.FromArgb(73, 63, 240);
        public Color B = Color.FromArgb(0, 164, 137);
        public HeroPanel() { DoubleBuffered = true; }
        protected override void OnPaintBackground(PaintEventArgs e)
        {
            using (var br = new LinearGradientBrush(ClientRectangle, A, B, 18f))
                e.Graphics.FillRectangle(br, ClientRectangle);
        }
    }

    sealed class FtpResponse
    {
        public int Code;
        public string Text;
    }

    sealed class FtpItem
    {
        public string Name;
        public string FullPath;
        public bool IsDirectory;
        public long Size;
        public DateTime ModifiedUtc;
    }

    sealed class RemoteFile
    {
        public string RemotePath;
        public string FinalPath;
        public string PartPath;
        public long Size;
        public DateTime ModifiedUtc;
    }

    sealed class FtpEndpoint
    {
        public string Host;
        public int Port;
        public override string ToString() { return "ftp://" + Host + ":" + Port + "/"; }
    }

    sealed class FtpSession : IDisposable
    {
        readonly string host;
        readonly int port;
        readonly bool preferTurbo;

        TcpClient control;
        NetworkStream stream;
        StreamWriter writer;
        bool turboActive;
        byte[] transferBuffer;

        public FtpSession(string host, int port, bool preferTurbo)
        {
            this.host = host;
            this.port = port;
            this.preferTurbo = preferTurbo;
        }

        public bool TurboActive { get { return turboActive; } }

        public async Task ConnectAsync(CancellationToken token)
        {
            DisposeControl();

            control = new TcpClient();
            control.NoDelay = true;
            control.ReceiveBufferSize = 4 * 1024 * 1024;
            control.SendBufferSize = 1024 * 1024;

            await ConnectTcpAsync(control, host, port, 6000, token);

            stream = control.GetStream();
            stream.ReadTimeout = 30000;
            stream.WriteTimeout = 30000;

            writer = new StreamWriter(stream, new UTF8Encoding(false), 16 * 1024);
            writer.NewLine = "\r\n";
            writer.AutoFlush = true;

            var hello = await ReadResponseAsync(8000, token);
            Expect(hello, 220);

            var u = await CommandAsync("USER flashdrop", token);
            if (u.Code != 230 && u.Code != 331)
                throw new IOException("FTP login failed: " + u.Text);

            if (u.Code == 331)
            {
                var p = await CommandAsync("PASS turbo", token);
                Expect(p, 230);
            }

            var o = await CommandAsync("OPTS UTF8 ON", token);
            if (o.Code >= 400) { }

            var t = await CommandAsync("TYPE I", token);
            Expect(t, 200);

            turboActive = false;

            if (preferTurbo)
            {
                var x = await CommandAsync("XFD1", token);
                if (x.Code == 200)
                    turboActive = true;
            }
        }

        public async Task<List<FtpItem>> ListAsync(string remotePath, CancellationToken token)
        {
            EnsureConnected();

            if (turboActive)
                throw new IOException("Folder listing is not available inside Turbo stream mode");

            using (var data = await OpenPassiveAsync(token))
            {
                string path = NormalizeRemote(remotePath);
                var start = await CommandAsync("MLSD " + path, token);

                if (start.Code != 150 && start.Code != 125)
                    throw new IOException("Cannot list " + path + ": " + start.Text);

                string text;

                using (var sr = new StreamReader(data.GetStream(), new UTF8Encoding(false), false, 64 * 1024))
                {
                    var readTask = sr.ReadToEndAsync();
                    var winner = await Task.WhenAny(readTask, Task.Delay(20000, token));

                    if (winner != readTask)
                        throw new IOException("FTP folder listing timed out");

                    text = await readTask;
                }

                data.Close();

                var finish = await ReadResponseAsync(10000, token);

                if (finish.Code != 226 && finish.Code != 250)
                    throw new IOException("FTP list did not finish: " + finish.Text);

                return ParseMlsd(text, path);
            }
        }

        public async Task DownloadAsync(
            string remotePath,
            string localPartPath,
            long expectedSize,
            long offset,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes)
        {
            EnsureConnected();

            if (turboActive)
            {
                await DownloadPersistentTurboAsync(
                    remotePath,
                    localPartPath,
                    expectedSize,
                    offset,
                    bufferBytes,
                    token,
                    onBytes);
                return;
            }

            await DownloadStandardFtpAsync(
                remotePath,
                localPartPath,
                expectedSize,
                offset,
                bufferBytes,
                token,
                onBytes);
        }

        async Task DownloadPersistentTurboAsync(
            string remotePath,
            string localPartPath,
            long expectedSize,
            long offset,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes)
        {
            string encoded = Convert.ToBase64String(
                Encoding.UTF8.GetBytes(NormalizeRemote(remotePath)));

            await writer.WriteLineAsync(
                "GET " +
                offset.ToString(CultureInfo.InvariantCulture) +
                " 0 " +
                encoded);
            await writer.FlushAsync();

            var start = await ReadResponseAsync(15000, token);

            if (start.Code != 150)
                throw new IOException("Turbo GET failed: " + start.Text);

            string[] p = start.Text.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

            if (p.Length < 3)
                throw new IOException("Invalid Turbo header: " + start.Text);

            long length;
            long total;

            if (!long.TryParse(p[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out length) ||
                !long.TryParse(p[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out total))
                throw new IOException("Invalid Turbo file size header");

            if (total != expectedSize)
                throw new IOException("Phone file size changed: " + total + " / " + expectedSize);

            if (offset + length != expectedSize)
                throw new IOException("Unexpected Turbo range length");

            EnsureTransferBuffer(bufferBytes);

            Directory.CreateDirectory(Path.GetDirectoryName(localPartPath));

            using (var fs = new FileStream(
                localPartPath,
                FileMode.OpenOrCreate,
                FileAccess.Write,
                FileShare.Read,
                bufferBytes,
                FileOptions.SequentialScan))
            {
                fs.Seek(offset, SeekOrigin.Begin);

                if (fs.Length != offset)
                    fs.SetLength(offset);

                long got = 0;

                while (got < length)
                {
                    token.ThrowIfCancellationRequested();

                    int want = (int)Math.Min(transferBuffer.Length, length - got);
                    int n = await ReadWithTimeoutAsync(
                        stream,
                        transferBuffer,
                        0,
                        want,
                        20000,
                        token);

                    if (n <= 0)
                        throw new IOException("Turbo stream closed early");

                    fs.Write(transferBuffer, 0, n);
                    got += n;

                    if (onBytes != null)
                        onBytes(n);
                }
            }

            var finish = await ReadResponseAsync(12000, token);

            if (finish.Code != 226)
                throw new IOException("Turbo file did not finish: " + finish.Text);
        }

        async Task DownloadStandardFtpAsync(
            string remotePath,
            string localPartPath,
            long expectedSize,
            long offset,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes)
        {
            using (var data = await OpenPassiveAsync(token))
            {
                if (offset > 0)
                {
                    var rest = await CommandAsync(
                        "REST " + offset.ToString(CultureInfo.InvariantCulture),
                        token);
                    Expect(rest, 350);
                }

                string path = NormalizeRemote(remotePath);
                var start = await CommandAsync("RETR " + path, token);

                if (start.Code != 150 && start.Code != 125)
                    throw new IOException("Cannot download " + path + 