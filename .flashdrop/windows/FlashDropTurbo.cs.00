using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Diagnostics;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.NetworkInformation;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Runtime.InteropServices;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace FlashDropTurbo
{
    static class Program
    {
        [STAThread]
        static void Main()
        {
            ServicePointManager.DefaultConnectionLimit = 64;
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }

    sealed class HeroPanel : Panel
    {
        public Color A = Color.FromArgb(73, 63, 240);
        public Color B = Color.FromArgb(0, 164, 137);
        public HeroPanel() { DoubleBuffered = true; }
        protected override void OnPaintBackground(PaintEventArgs e)
        {
            using (var br = new LinearGradientBrush(ClientRectangle, A, B, 18f))
                e.Graphics.FillRectangle(br, ClientRectangle);
        }
    }

    sealed class FtpResponse
    {
        public int Code;
        public string Text;
    }

    sealed class FtpItem
    {
        public string Name;
        public string FullPath;
        public bool IsDirectory;
        public long Size;
        public DateTime ModifiedUtc;
    }

    sealed class RemoteFile
    {
        public string RemotePath;
        public string FinalPath;
        public string PartPath;
        public long Size;
        public DateTime ModifiedUtc;
    }

    sealed class FtpEndpoint
    {
        public string Host;
        public int Port;
        public override string ToString() { return "ftp://" + Host + ":" + Port + "/"; }
    }

    sealed class FtpSession : IDisposable
    {
        readonly string host;
        readonly int port;
        readonly bool preferTurbo;
        readonly string pin;

        TcpClient control;
        NetworkStream stream;
        StreamWriter writer;
        bool turboActive;
        bool packedActive;
        byte[] transferBuffer;

        public FtpSession(string host, int port, bool preferTurbo, string pin)
        {
            this.host = host;
            this.port = port;
            this.preferTurbo = preferTurbo;
            this.pin = pin == null ? "" : pin.Trim();
        }

        public bool TurboActive { get { return turboActive; } }
        public bool PackedActive { get { return packedActive; } }

        public async Task ConnectAsync(CancellationToken token)
        {
            DisposeControl();

            control = new TcpClient();
            control.NoDelay = true;
            control.ReceiveBufferSize = 4 * 1024 * 1024;
            control.SendBufferSize = 1024 * 1024;

            await ConnectTcpAsync(control, host, port, 6000, token);

            stream = control.GetStream();
            stream.ReadTimeout = 30000;
            stream.WriteTimeout = 30000;

            writer = new StreamWriter(stream, new UTF8Encoding(false), 16 * 1024);
            writer.NewLine = "\r\n";
            writer.AutoFlush = true;

            var hello = await ReadResponseAsync(8000, token);
            Expect(hello, 220);

            var u = await CommandAsync("USER bharat", token);
            if (u.Code != 230 && u.Code != 331)
                throw new IOException("FTP login failed: " + u.Text);

            if (u.Code == 331)
            {
                var p = await CommandAsync("PASS " + pin, token);
                Expect(p, 230);
            }

            var o = await CommandAsync("OPTS UTF8 ON", token);
            if (o.Code >= 400) { }

            var t = await CommandAsync("TYPE I", token);
            Expect(t, 200);

            turboActive = false;
            packedActive = false;

            if (preferTurbo)
            {
                var p2 = await CommandAsync("XFD2", token);

                if (p2.Code == 200)
                {
                    packedActive = true;
                }
                else
                {
                    var x = await CommandAsync("XFD1", token);
                    if (x.Code == 200)
                        turboActive = true;
                }
            }
        }

        public async Task<List<FtpItem>> ListAsync(string remotePath, CancellationToken token)
        {
            EnsureConnected();

            if (turboActive || packedActive)
                throw new IOException("Folder listing is not available inside Turbo stream mode");

            using (var data = await OpenPassiveAsync(token))
            {
                string path = NormalizeRemote(remotePath);
                var start = await CommandAsync("MLSD " + path, token);

                if (start.Code != 150 && start.Code != 125)
                    throw new IOException("Cannot list " + path + ": " + start.Text);

                string text;

                using (var sr = new StreamReader(data.GetStream(), new UTF8Encoding(false), false, 64 * 1024))
                {
                    var readTask = sr.ReadToEndAsync();
                    var winner = await Task.WhenAny(readTask, Task.Delay(20000, token));

                    if (winner != readTask)
                        throw new IOException("FTP folder listing timed out");

                    text = await readTask;
                }

                data.Close();

                var finish = await ReadResponseAsync(10000, token);

                if (finish.Code != 226 && finish.Code != 250)
                    throw new IOException("FTP list did not finish: " + finish.Text);

                return ParseMlsd(text, path);
            }
        }

        public async Task DownloadBatchAsync(
            List<RemoteFile> files,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes,
            Action waitIfPaused)
        {
            EnsureConnected();

            if (!packedActive)
                throw new IOException("Packed stream mode is not active");

            if (files == null || files.Count == 0)
                return;

            files = files.Where(f =>
                !(File.Exists(f.FinalPath) &&
                  new FileInfo(f.FinalPath).Length == f.Size)).ToList();

            if (files.Count == 0)
                return;

            if (files.Count > 2000)
                throw new IOException("Packed batch is too large");

            await writer.WriteLineAsync(
                "BATCH " + files.Count.ToString(CultureInfo.InvariantCulture));

            long[] offsets = new long[files.Count];

            for (int i = 0; i < files.Count; i++)
            {
                var f = files[i];
                long offset = SafePartLengthLocal(f);
                offsets[i] = offset;

                string encoded = Convert.ToBase64String(
                    Encoding.UTF8.GetBytes(NormalizeRemote(f.RemotePath)));

                await writer.WriteLineAsync(
                    offset.ToString(CultureInfo.InvariantCulture) +
                    " " +
                    encoded);
            }

            await writer.FlushAsync();

            var begin = await ReadResponseAsync(20000, token);

            if (begin.Code != 150)
                throw new IOException("Packed batch rejected: " + begin.Text);

            EnsureTransferBuffer(bufferBytes);

            for (int i = 0; i < files.Count; i++)
            {
                token.ThrowIfCancellationRequested();
                if (waitIfPaused != null) waitIfPaused();

                var header = await ReadResponseAsync(30000, token);

                if (header.Code == 550)
                    throw new IOException("Phone file unavailable: " + files[i].RemotePath);

                if (header.Code != 151)
                    throw new IOException("Invalid packed file header: " + header.Text);

                string[] p = header.Text.Split(
                    new[] { ' ' },
                    StringSplitOptions.RemoveEmptyEntries);

                if (p.Length < 4)
                    throw new IOException("Invalid packed file header: " + header.Text);

                int index;
                long length;
                long total;

                if (!int.TryParse(p[1], out index) ||
                    !long.TryParse(p[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out length) ||
                    !long.TryParse(p[3], NumberStyles.Integer, CultureInfo.InvariantCulture, out total))
                    throw new IOException("Invalid packed file metadata");

                if (index != i)
                    throw new IOException("Packed stream file order mismatch");

                var file = files[i];

                if (total != file.Size)
                    throw new IOException("Phone file size changed: " + file.RemotePath);

                long offset = offsets[i];

                if (offset + length != total)
                    throw new IOException("Packed resume range mismatch: " + file.RemotePath);

                Directory.CreateDirectory(Path.GetDirectoryName(file.PartPath));

                using (var fs = new FileStream(
                    file.PartPath,
                    FileMode.OpenOrCreate,
                    FileAccess.Write,
                    FileShare.Read,
                    bufferBytes,
                    FileOptions.SequentialScan))
                {
                    fs.Seek(offset, SeekOrigin.Begin);

                    if (fs.Length != offset)
                        fs.SetLength(offset);

                    long got = 0;

                    while (got < length)
                    {
                        token.ThrowIfCancellationRequested();
                        if (waitIfPaused != null) waitIfPaused();

                        int want = (int)Math.Min(
                            transferBuffer.Length,
                            length - got);

                        int n = await ReadWithTimeoutAsync(
                            stream,
                            transferBuffer,
                            0,
                            want,
                            30000,
                            token);

                        if (n <= 0)
                            throw new IOException(
                                "Packed stream closed during " +
                                file.RemotePath);

                        fs.Write(transferBuffer, 0, n);
                        got += n;

                        if (onBytes != null)
                            onBytes(n);
                    }
                }

                var end = await ReadResponseAsync(15000, token);

                if (end.Code != 152)
                    throw new IOException("Packed file did not finish: " + end.Text);

                FinalizeLocalFile(file);
            }

            var done = await ReadResponseAsync(15000, token);

            if (done.Code != 226)
                throw new IOException("Packed batch did not finish: " + done.Text);
        }

        public async Task VerifyBatchAsync(
            List<RemoteFile> files,
            CancellationToken token,
            ConcurrentQueue<string> verifyErrors,
            Action waitIfPaused)
        {
            EnsureConnected();

            if (files == null || files.Count == 0)
                return;

            if (files.Count > 500)
                throw new IOException("Verification batch too large");

            var start = await CommandAsync(
                "XHASHB " + files.Count.ToString(CultureInfo.InvariantCulture),
                token);

            if (start.Code != 150)
                throw new IOException("Phone does not support SHA-256 verification: " + start.Text);

            foreach (var f in files)
            {
                string encoded = Convert.ToBase64String(
                    Encoding.UTF8.GetBytes(NormalizeRemote(f.RemotePath)));
                await writer.WriteLineAsync(encoded);
            }
            await writer.FlushAsync();

            for (int i = 0; i < files.Count; i++)
            {
                token.ThrowIfCancellationRequested();
                if (waitIfPaused != null) waitIfPaused();

                var response = await ReadResponseAsync(120000, token);
                var file = files[i];

                if (response.Code != 213)
                {
                    verifyErrors.Enqueue(file.RemotePath + " : phone hash unavailable");
                    continue;
                }

                string[] p = response.Text.Split(
                    new[] { ' ' },
                    StringSplitOptions.RemoveEmptyEntries);

                if (p.Length < 4)
                {
                    verifyErrors.Enqueue(file.RemotePath + " : invalid hash response");
                    continue;
                }

                long remoteSize;
                if (!long.TryParse(p[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out remoteSize))
                {
                    verifyErrors.Enqueue(file.RemotePath + " : invalid remote size");
                    continue;
                }

                string remoteHash = p[3].Trim();

                if (!File.Exists(file.FinalPath))
                {
                    verifyErrors.Enqueue(file.RemotePath + " : local file missing");
                    continue;
                }

                var info = new FileInfo(file.FinalPath);
                if (info.Length != remoteSize)
                {
                    verifyErrors.Enqueue(file.RemotePath + " : size mismatch");
                    continue;
                }

                string localHash = Sha256File(file.FinalPath, token, waitIfPaused);

                if (!string.Equals(localHash, remoteHash, StringComparison.OrdinalIgnoreCase))
                    verifyErrors.Enqueue(file.RemotePath + " : SHA-256 mismatch");
            }

            var done = await ReadResponseAsync(3