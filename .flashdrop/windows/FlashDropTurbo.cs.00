using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Diagnostics;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.NetworkInformation;
using System.Net.Sockets;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using System.Web.Script.Serialization;
using System.Windows.Forms;

namespace FlashDropTurbo
{
    static class Program
    {
        [STAThread]
        static void Main()
        {
            ServicePointManager.DefaultConnectionLimit = 64;
            ServicePointManager.Expect100Continue = false;
            ServicePointManager.UseNagleAlgorithm = false;
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }

    sealed class HeroPanel : Panel
    {
        public Color A = Color.FromArgb(53, 62, 246);
        public Color B = Color.FromArgb(9, 180, 154);
        public HeroPanel() { DoubleBuffered = true; }
        protected override void OnPaintBackground(PaintEventArgs e)
        {
            using (var br = new LinearGradientBrush(ClientRectangle, A, B, 18f)) e.Graphics.FillRectangle(br, ClientRectangle);
        }
    }

    sealed class PhoneItem
    {
        public string name { get; set; }
        public string path { get; set; }
        public bool dir { get; set; }
        public long size { get; set; }
        public long modified { get; set; }
    }

    sealed class ListResponse
    {
        public string path { get; set; }
        public PhoneItem[] items { get; set; }
        public string error { get; set; }
    }

    sealed class RemoteFile
    {
        public string RemotePath;
        public string RelativePath;
        public long Size;
        public long Modified;
        public string FinalPath;
        public string PartPath;
        public int RemainingChunks;
    }

    sealed class ChunkJob
    {
        public RemoteFile File;
        public long Start;
        public long End;
    }

    sealed class MainForm : Form
    {
        readonly Color Ink = Color.FromArgb(18, 28, 50);
        readonly Color Muted = Color.FromArgb(98, 108, 128);
        readonly Color Blue = Color.FromArgb(63, 77, 246);
        readonly Color Green = Color.FromArgb(13, 160, 130);
        readonly Color Bg = Color.FromArgb(245, 247, 252);

        TextBox addressBox, pinBox, localBox;
        Label connectionLabel, pathLabel, statusLabel, speedLabel, totalLabel;
        ListView remoteList;
        Button detectBtn, connectBtn, upBtn, refreshBtn, browseBtn, startBtn, cancelBtn, openBtn;
        NumericUpDown workersBox, chunkBox;
        ProgressBar progress;
        string currentPath = "";
        CancellationTokenSource cts;
        long totalBytes, completedBytes;
        Stopwatch transferWatch;
        System.Windows.Forms.Timer speedTimer;
        readonly JavaScriptSerializer json = new JavaScriptSerializer { MaxJsonLength = int.MaxValue };

        public MainForm()
        {
            Text = "FlashDrop Turbo v1.4 - by Shashank Patel";
            StartPosition = FormStartPosition.CenterScreen;
            MinimumSize = new Size(1000, 720);
            Size = new Size(1180, 820);
            BackColor = Bg;
            Font = new Font("Segoe UI", 9.5f);
            Icon = SystemIcons.Shield;
            AutoScaleMode = AutoScaleMode.Dpi;
            FormBorderStyle = FormBorderStyle.Sizable;
            MaximizeBox = true;
            BuildUi();
            Shown += async (s, e) => await AutoDetectAsync();
        }

        void BuildUi()
        {
            SuspendLayout();

            var outer = new TableLayoutPanel {
                Dock = DockStyle.Fill,
                ColumnCount = 1,
                RowCount = 5,
                BackColor = Bg,
                Padding = new Padding(18, 14, 18, 14)
            };
            outer.RowStyles.Add(new RowStyle(SizeType.Absolute, 108));
            outer.RowStyles.Add(new RowStyle(SizeType.Absolute, 136));
            outer.RowStyles.Add(new RowStyle(SizeType.Percent, 100));
            outer.RowStyles.Add(new RowStyle(SizeType.Absolute, 122));
            outer.RowStyles.Add(new RowStyle(SizeType.Absolute, 96));
            Controls.Add(outer);

            var hero = new HeroPanel { Dock = DockStyle.Fill, Margin = new Padding(0,0,0,10) };
            outer.Controls.Add(hero,0,0);

            var title = L("FLASHDROP TURBO", 23, Color.White, true);
            title.Location = new Point(26, 16);
            hero.Controls.Add(title);

            var sub = L("High-speed sequential streaming over your 5 GHz hotspot", 11.5f, Color.FromArgb(236,244,255), false);
            sub.Location = new Point(28, 52);
            hero.Controls.Add(sub);

            var by = L("Designed & built by Shashank Patel", 9.5f, Color.FromArgb(225,249,242), true);
            by.Location = new Point(28, 78);
            hero.Controls.Add(by);

            var connectCard = Card();
            connectCard.Margin = new Padding(0,0,0,10);
            outer.Controls.Add(connectCard,0,1);

            var grid = new TableLayoutPanel {
                Dock = DockStyle.Fill,
                ColumnCount = 7,
                RowCount = 3,
                Padding = new Padding(14,10,14,10),
                BackColor = Color.White
            };
            grid.RowStyles.Add(new RowStyle(SizeType.Absolute,24));
            grid.RowStyles.Add(new RowStyle(SizeType.Absolute,42));
            grid.RowStyles.Add(new RowStyle(SizeType.Percent,100));
            grid.ColumnStyles.Add(new ColumnStyle(SizeType.Percent,38));
            grid.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute,100));
            grid.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute,105));
            grid.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute,105));
            grid.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute,88));
            grid.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute,92));
            grid.ColumnStyles.Add(new ColumnStyle(SizeType.Percent,20));
            connectCard.Controls.Add(grid);

            grid.Controls.Add(L("PHONE HTTP ADDRESS",8.5f,Muted,true),0,0);
            grid.Controls.Add(L("6-DIGIT PIN",8.5f,Muted,true),1,0);
            grid.Controls.Add(L("WORKERS",8.5f,Muted,true),4,0);
 