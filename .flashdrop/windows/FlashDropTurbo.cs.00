    {
        public string RemotePath;
        public string RelativePath;
        public long Size;
        public long Modified;
        public string FinalPath;
        public string PartPath;
        public int RemainingChunks;
    }

    sealed class ChunkJob
    {
        public RemoteFile File;
        public long Start;
        public long End;
    }

