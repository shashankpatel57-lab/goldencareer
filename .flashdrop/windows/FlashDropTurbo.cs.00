        sealed class WriteBlock
        {
            public byte[] Buffer;
            public int Count;
        }

        sealed class TurboSession : IDisposable
        {
            readonly string host;
            readonly int port;
            readonly string pin;
            TcpClient client;
            NetworkStream stream;

            public TurboSession(string host,int port,string pin)
            {
                this.host=host;
                this.port=port;
                this.pin=pin;
            }

            public NetworkStream Stream { get { return stream; } }

            public async Task EnsureConnectedAsync()
            {
                if(client!=null && stream!=null && client.Connected)return;

                Close();

                client=new TcpClient();
                client.NoDelay=true;
                client.ReceiveBufferSize=4*1024*1024;
                client.SendBufferSize=1024*1024;
                await client.ConnectAsync(host,port);
                stream=client.GetStream();
                stream.ReadTimeout=15000;
                stream.WriteTimeout=15000;
            }

            public async Task SendGetAsync(string remotePath,long offset,CancellationToken token)
            {
                await EnsureConnectedAsync();

                string encoded=Convert.ToBase64String(Encoding.UTF8.GetBytes(remotePath??""));
                string request=
                    "FLASHDROP/1\n"+
                    "PIN "+pin+"\n"+
                    "MODE GET\n"+
                    "PATH "+encoded+"\n"+
                    "OFFSET "+offset+"\n\n";

                byte[] hdr=Encoding.UTF8.GetBytes(request);
                await stream.WriteAsync(hdr,0,hdr.Length,token);
            }

            public void Close()
            {
                try{if(stream!=null)stream.Dispose();}catch{}
                try{if(client!=null)client.Close();}catch{}
                stream=null;
                client=null;
            }

            public void Dispose(){Close();}
        }

        public MainForm()
        {
            Text = "FlashDrop Turbo v1.7 - by Shashank Patel";
            StartPosition = FormStartPosition.CenterScreen;
            MinimumSize = new Size(1000, 720);
            Size = new Size(1180, 820);
            BackColor = Bg;
            Font = new Font("Segoe UI", 9.5f);
            Icon = SystemIcons.Shield;
            AutoScaleMode = AutoScaleMode.Dpi;
            FormBorderStyle = FormBorderStyle.Sizable;
            MaximizeBox = true;
            BuildUi();
            Shown += async (s, e) => await AutoDetectAsync();
        }

