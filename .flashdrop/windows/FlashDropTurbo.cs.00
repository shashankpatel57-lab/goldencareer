namespace FlashDropTurbo
{
    static class Program
    {
        [STAThread]
        static void Main()
        {
            ServicePointManager.DefaultConnectionLimit = 64;
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }

    sealed class HeroPanel : Panel
    {
        public Color A = Color.FromArgb(73, 63, 240);
        public Color B = Color.FromArgb(0, 164, 137);
        public HeroPanel() { DoubleBuffered = true; }
        protected override void OnPaintBackground(PaintEventArgs e)
        {
            using (var br = new LinearGradientBrush(ClientRectangle, A, B, 18f))
                e.Graphics.FillRectangle(br, ClientRectangle);
        }
    }

    sealed class FtpResponse
    {
        public int Code;
        public string Text;
    }

    sealed class FtpItem
    {
        public string Name;
        public string FullPath;
        public bool IsDirectory;
        public long Size;
        public DateTime ModifiedUtc;
    }

    sealed class RemoteFile
    {
        public string RemotePath;
        public string FinalPath;
        public string PartPath;
        public long Size;
        public DateTime ModifiedUtc;
    }

    sealed class FtpEndpoint
    {
        public string Host;
        public int Port;
        public override string ToString() { return "ftp://" + Host + ":" + Port + "/"; }
    }

    sealed class FtpSession : IDisposable
    {
        readonly string host;
        readonly int port;
        TcpClient control;
        StreamReader reader;
        StreamWriter writer;

        public FtpSession(string host, int port)
        {
            this.host = host;
            this.port = port;
        }

        public async Task ConnectAsync(CancellationToken token)
        {
            DisposeControl();

            control = new TcpClient();
            control.NoDelay = true;
            control.ReceiveBufferSize = 256 * 1024;
            control.SendBufferSize = 256 * 1024;

            await ConnectTcpAsync(control, host, port, 6000, token);

            reader = new StreamReader(control.GetStream(), new UTF8Encoding(false), false, 16 * 1024);
            writer = new StreamWriter(control.GetStream(), new UTF8Encoding(false), 16 * 1024);
            writer.NewLine = "\r\n";
            writer.AutoFlush = true;

            var hello = await ReadResponseAsync(8000, token);
            Expect(hello, 220);

            var u = await CommandAsync("USER flashdrop", token);
            if (u.Code != 230 && u.Code != 331) throw new IOException("FTP login failed: " + u.Text);

            if (u.Code == 331)
            {
                var p = await CommandAsync("PASS turbo", token);
                Expect(p, 230);
            }

            var o = await CommandAsync("OPTS UTF8 ON", token);
            if (o.Code >= 400) { }

            var t = await CommandAsync("TYPE I", token);
            Expect(t, 200);
        }

        public async Task<List<FtpItem>> ListAsync(string remotePath, CancellationToken token)
        {
            EnsureConnected();

            using (var data = await OpenPassiveAsync(token))
            {
                string path = NormalizeRemote(remotePath);
                var start = await CommandAsync("MLSD " + path, token);
                if (start.Code != 150 && start.Code != 125)
                    throw new IOException("Cannot list " + path + ": " + start.Text);

                string text;
                using (var sr = new StreamReader(data.GetStream(), new UTF8Encoding(false), false, 64 * 1024))
                {
                    var readTask = sr.ReadToEndAsync();
                    var winner = await Task.WhenAny(readTask, Task.Delay(20000, token));
                    if (winner != readTask) throw new IOException("FTP folder listing timed out");
                    text = await readTask;
                }

                data.Close();

                var end = await ReadResponseAsync(10000, token);
                if (end.Code != 226 && end.Code != 250)
                    throw new IOException("FTP list did not finish: " + end.Text);

                return ParseMlsd(text, path);
            }
        }

        public async Task DownloadAsync(
            string remotePath,
            string localPartPath,
            long expectedSize,
            long offset,
            int bufferBytes,
            CancellationToken token,
            Action<int> onBytes)
        {
            EnsureConnected();

            using (var data = await OpenPassiveAsync(token))
            {
                if (offset > 0)
                {
                    var rest = await CommandAsync("REST " + offset.ToString(CultureInfo.InvariantCulture), token);
                    Expect(rest, 350);
                }

                string path = NormalizeRemote(remotePath);
                var start = await CommandAsync("RETR " + path, token);
                if (start.Code != 150 && start.Code != 125)
                    throw new IOException("Cannot download " + path + ": " + start.Text);

                data.ReceiveBufferSize = 4 * 1024 * 1024;
                data.NoDelay = true;

                Directory.CreateDirectory(Path.GetDirectoryName(localPartPath));

                using (var fs = new FileStream(
                    localPartPath,
                    FileMode.OpenOrCreate,
                    FileAccess.Write,
                    FileShare.Read,
                    bufferBytes,
                    FileOptions.SequentialScan | FileOptions.Asynchronous))
                {
                    fs.Seek(offset, SeekOrigin.Begin);
                    if (fs.Length != offset) fs.SetLength(offset);

                    byte[] buffer = new byte[bufferBytes];
                    long got = offset;
                    Stream input = data.GetStream();

                    while (got < expectedSize)
                    {
                        token.ThrowIfCancellationRequested();

                        int want = (int)Math.Min(buffer.Length, expectedSize - got);
                        int n = await ReadWithTimeoutAsync(input, buffer, 0, want, 20000, token);

                        if (n <= 0) break;

                        await fs.WriteAsync(buffer, 0, n, token);
                        got += n;
                        if (onBytes != null) onBytes(n);
                    }

                    if (got != expectedSize)
                        throw new IOException("Incomplete FTP file: " + got + " / " + expectedSize);
                }

                data.Close();

                var end = await ReadResponseAsync(12000, token);
                if (end.Code != 226 && end.Code != 250)
                    throw new IOException("FTP transfer did not finish: " + end.Text);
            }
        }

        async Task<TcpClient> OpenPassiveAsync(CancellationToken token)
        {
            var epsv = await CommandAsync("EPSV", token);

            int dataPort = 0;

            if (epsv.Code == 229)
            {
                int a = epsv.Text.IndexOf("(|||", StringComparison.Ordinal);
                int b = a >= 0 ? epsv.Text.IndexOf("|)", a + 4, StringComparison.Ordinal) : -1;

                if (a >= 0 && b > a)
                {
                    string p = epsv.Text.Substring(a + 4, b - (a + 4));
                    int.TryParse(p, out dataPort);
                }
            }

            if (dataPort <= 0)
            {
                var pasv = await CommandAsync("PASV", token);
                Expect(pasv, 227);

                int l = pasv.Text.IndexOf('(');
                int r = pasv.Text.IndexOf(')', l + 1);
                if (l < 0 || r <= l) throw new IOException("Invalid PASV response");

                string[] v = pasv.Text.Substring(l + 1, r - l - 1).Split(',');
                if (v.Length != 6) throw new IOException("Invalid PASV response");

                int p1, p2;
                if (!int.TryParse(v[4], out p1) || !int.TryParse(v[5], out p2))
                    throw new IOException("Invalid PASV port");

                dataPort = p1 * 256 + p2;
            }

            var data = new TcpClient();
            data.NoDelay = true;
            data.ReceiveBufferSize = 4 * 1024 * 1024;
            await ConnectTcpAsync(data, host, dataPort, 6000, token);
            return data;
        }

        async Task<FtpResponse> CommandAsync(string command, CancellationToken token)
        {
            EnsureConnected();
            await writer.WriteLineAsync(command);
            return await ReadResponseAsync(12000, token);
        }

