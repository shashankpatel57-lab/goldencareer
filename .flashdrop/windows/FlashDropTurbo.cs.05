            long got=0;

                while(got<remaining)
                {
                    token.ThrowIfCancellationRequested();

                    int n=await ReadWithTimeoutAsync(
                        input,buf,0,(int)Math.Min(buf.Length,remaining-got),token,20000);

                    if(n<=0)
                        throw new IOException("File stream ended early");

                    await fs.WriteAsync(buf,0,n,token);
                    got+=n;
                    Interlocked.Add(ref completedBytes,n);
                }
            }

            FinalizePartFile(file);
        }

        async Task DownloadFilesHttpFallbackAsync(
            List<RemoteFile> files,
            CancellationToken token,
            ConcurrentQueue<string> errors)
        {
            foreach(var file in files)
            {
                token.ThrowIfCancellationRequested();

                if(File.Exists(file.FinalPath) && new FileInfo(file.FinalPath).Length==file.Size)
                    continue;

                bool ok=false;
                Exception last=null;

                for(int attempt=1;attempt<=4 && !ok;attempt++)
                {
                    try
                    {
                        await DownloadSingleHttpFileAsync(file,token);
                        ok=true;
                    }
                    catch(Exception ex)
                    {
                        last=ex;
                        Thread.Sleep(200*attempt);
                    }
                }

                if(!ok)
                    errors.Enqueue(file.RemotePath+" : "+(last==null?"HTTP fallback failed":last.Message));
            }
        }

        async Task DownloadSingleHttpFileAsync(
            RemoteFile file,
            CancellationToken token)
        {
            long offset=SafePartialLength(file);
            string url=BaseUrl+"/api/file?pin="+Uri.EscapeDataString(Pin)+
                "&path="+Uri.EscapeDataString(file.RemotePath??"");

            var req=(HttpWebRequest)WebRequest.Create(url);
            req.Method="GET";
            req.Proxy=null;
            req.KeepAlive=true;
            req.Timeout=30000;
            req.ReadWriteTimeout=30000;

            if(offset>0)
                req.AddRange(offset);

            using(token.Register(()=>{try{req.Abort();}catch{}}))
            using(var res=(HttpWebResponse)await req.GetResponseAsync())
            using(var input=res.GetResponseStream())
            {
                int bufferBytes=(int)chunkBox.Value*1024*1024;
                bufferBytes=Math.Max(512*1024,Math.Min(8*1024*1024,bufferBytes));
                byte[] buf=new byte[bufferBytes];

                Directory.CreateDirectory(Path.GetDirectoryName(file.FinalPath));

                using(var fs=new FileStream(
                    file.PartPath,
                    FileMode.OpenOrCreate,
                    FileAccess.Write,
                    FileShare.Read,
                    bufferBytes,
                    FileOptions.SequentialScan | FileOptions.Asynchronous))
                {
                    fs.Seek(offset,SeekOrigin.Begin);
                    if(fs.Length!=offset)fs.SetLength(offset);

                    long got=offset;

                    while(got<file.Size)
                    {
                        token.ThrowIfCancellationRequested();

                        int n=await ReadWithTimeoutAsync(
                            input,buf,0,(int)Math.Min(buf.Length,file.Size-got),token,20000);

                        if(n<=0)break;

                        await fs.WriteAsync(buf,0,n,token);
                        got+=n;
                        Interlocked.Add(ref completedBytes,n);
                    }

                    if(got!=file.Size)
                        throw new IOException("HTTP file incomplete "+got+"/"+file.Size);
                }
            }

            FinalizePartFile(file);
        }

        void FinalizePartFile(RemoteFile file)
        {
            long localSize=File.Exists(file.PartPath)
                ? new FileInfo(file.PartPath).Length
                : 0;

            if(localSize!=file.Size)
                throw new IOException(
                    "Incomplete local file "+localSize+"/"+file.Size+
                    " for "+file.RemotePath);

            if(File.Exists(file.FinalPath))
                File.Delete(file.FinalPath);

            File.Move(file.PartPath,file.FinalPath);

            if(file.Modified>0)
            {
                try
                {
                    File.SetLastWriteTime(
                        file.FinalPath,
                        DateTimeOffset.FromUnixTimeMilliseconds(file.Modified).LocalDateTime);
                }
                catch{}
            }
        }

        async Task<string> ReadAsciiLineWithTimeoutAsync(
            Stream input,
            CancellationToken token,
            int timeoutMs)
        {
            var bytes=new List<byte>(128);
            var one=new byte[1];

            while(bytes.Count<8192)
            {
                int n=await ReadWithTimeoutAsync(input,one,0,1,token,timeoutMs);

                if(n<=0)break;
                if(one[0]==10)break;
                if(one[0]!=13)bytes.Add(one[0]);
            }

            return Encoding.UTF8.GetString(bytes.ToArray());
        }

        async Task<int> ReadWithTimeoutAsync(
            Stream input,
            byte[] buffer,
            int offset,
            int count,
            CancellationToken token,
            int timeoutMs)
        {
            var readTask=input.ReadAsync(buffer,offset,count,token);
            var timeoutTask=Task.Delay(timeoutMs,token);
            var finished=await Task.WhenAny(readTask,timeoutTask);

            if(finished!=readTask)
            {
                token.ThrowIfCancellationRequested();
                throw new IOException(
                    "No data received for "+(timeoutMs/1000)+
                    " seconds; reconnecting and resuming.");
            }

            return await readTask;
        }

        void UpdateSpeed()
        {
            if(transferWatch==null)return;

            long done=Interlocked.Read(ref completedBytes);
            DateTime now=DateTime.UtcNow;
            double dt=Math.Max(.001,(now-speedSampleAt).TotalSeconds);
            long delta=Math.Max(0,done-speedSampleBytes);
            double instant=delta/1048576d/dt;

            if(smoothedMbps<=0)smoothedMbps=instant;
            else smoothedMbps=(smoothedMbps*0.60)+(instant*0.40);

            speedSampleBytes=done;
            speedSampleAt=now;

            speedLabel.Text=smoothedMbps.ToString("0.0")+" MB/s";

            if(totalBytes>0)
            {
                int v=(int)Math.Max(0,Math.Min(1000,done*1000d/totalBytes));
                progress.Value=v;

                double remaining=Math.Max(0,totalBytes-done);
                double eta=smoothedMbps>0.1?remaining/1048576d/smoothedMbps:0;
                totalLabel.Text=FormatBytes(done)+" / "+FormatBytes(totalBytes)
                    +(eta>0?" • ETA "+TimeSpan.FromSeconds(eta).ToString(eta>=3600?@"h\:mm\:ss":@"m\:ss"):"");
            }
        }

        void ToggleConnect(bool enabled)
        {
            detectBtn.Enabled=enabled; connectBtn.Enabled=enabled; upBtn.Enabled=enabled; refreshBtn.Enabled=enabled;
        }

        string WebMessage(WebException ex)
        {
            try
            {
                var r=ex.Response as HttpWebResponse;
                if(r!=null && r.StatusCode==HttpStatusCode.Forbidden)return "Wrong PIN. Check the FlashDrop app on the phone.";
            }catch{}
            return "Cannot reach phone: "+ex.Message;
        }
        void SetStatus(string s,bool error)
        {
            if(InvokeRequired){BeginInvoke((Action)(()=>SetStatus(s,error)));return;}
            statusLabel.Text=s; statusLabel.ForeColor=error?Color.FromArgb(185,55,55):Muted;
        }
        static string RemoteLeaf(string p)
        {
            var x=(p??"").TrimEnd('/').Replace('\\','/'); int i=x.LastIndexOf('/'); return i>=0?x.Substring(i+1):x;
        }
        static string Sanitize(string name)
        {
            if(string.IsNullOrWhiteSpace(name))return "unnamed";
            char[] bad=Path.GetInvalidFileNameChars(); var a=name.Select(c=>bad.Contains(c)?'_':c).ToArray(); string s=new string(a).Trim().TrimEnd('.');
            if(string.IsNullOrEmpty(s))s="unnamed";
            string u=s.ToUpperInvariant(); string[] r={"CON","PRN","AUX","NUL","COM1","COM2","COM3","COM4","COM5","COM6","COM7","COM8","COM9","LPT1","LPT2","LPT3","LPT4","LPT5","LPT6","LPT7","LPT8","LPT9"};
            if(r.Contains(u))s+="_"; return s;
        }
        static string FormatBytes(long b)
        {
            string[] u={"B","KB","MB","GB","TB"}; double v=b; int i=0; while(v>=1024&&i<u.Length-1){v/=1024;i++;} return (i==0?v.ToString("0"):v.ToString(v<10?"0.0":"0"))+" "+u[i];
        }
    }
}
