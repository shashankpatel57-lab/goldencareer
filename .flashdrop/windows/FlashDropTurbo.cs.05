            speedSampleBytes = nowBytes;
            speedSampleAt = now;

            speedLabel.Text = smoothedMbps.ToString("0.0") + " MB/s";

            if (totalBytes > 0)
            {
                progress.Value = (int)Math.Max(0, Math.Min(1000, nowBytes * 1000d / totalBytes));
                double remain = Math.Max(0, totalBytes - nowBytes);
                double eta = smoothedMbps > 0.2 ? remain / 1048576d / smoothedMbps : 0;

                totalLabel.Text =
                    FormatBytes(nowBytes) + " / " + FormatBytes(totalBytes) +
                    (eta > 0 ? " • ETA " + FormatDuration(eta) : "");
            }
        }

        async Task<FtpEndpoint> ResolveEndpointAsync(string input)
        {
            string host = ExtractHost(input);

            if (!string.IsNullOrEmpty(host))
            {
                int explicitPort = ExtractFtpPort(input);

                if (explicitPort > 0 && await ProbeFtpAsync(host, explicitPort, 900))
                    return new FtpEndpoint { Host = host, Port = explicitPort };

                for (int p = 2121; p <= 2130; p++)
                    if (await ProbeFtpAsync(host, p, 700))
                        return new FtpEndpoint { Host = host, Port = p };
            }

            return null;
        }

        static string ExtractHost(string input)
        {
            input = (input ?? "").Trim();
            if (input.Length == 0) return "";

            try
            {
                if (input.IndexOf("://", StringComparison.Ordinal) < 0)
                    input = "ftp://" + input;

                var u = new Uri(input);
                return u.Host;
            }
            catch { return ""; }
        }

        static int ExtractFtpPort(string input)
        {
            input = (input ?? "").Trim();

            try
            {
                if (!input.StartsWith("ftp://", StringComparison.OrdinalIgnoreCase))
                    return 0;

                var u = new Uri(input);
                return u.IsDefaultPort ? 21 : u.Port;
            }
            catch { return 0; }
        }

        static async Task<bool> ProbeFtpAsync(string host, int port, int timeoutMs)
        {
            try
            {
                using (var c = new TcpClient())
                {
                    var connect = c.ConnectAsync(host, port);
                    var winner = await Task.WhenAny(connect, Task.Delay(timeoutMs));
                    if (winner != connect) return false;
                    await connect;

                    using (var r = new StreamReader(c.GetStream(), new UTF8Encoding(false), false, 1024))
                    {
                        var lineTask = r.ReadLineAsync();
                        var readWinner = await Task.WhenAny(lineTask, Task.Delay(timeoutMs));
                        if (readWinner != lineTask) return false;
                        string line = await lineTask;
                        return line != null && line.StartsWith("220", StringComparison.Ordinal);
                    }
                }
            }
            catch { return false; }
        }

        void ChooseFolder()
        {
            using (var f = new FolderBrowserDialog
            {
                Description = "Choose where FlashDrop should save the phone folder",
                ShowNewFolderButton = true,
                SelectedPath = Directory.Exists(localBox.Text) ? localBox.Text : ""
            })
            {
                if (f.ShowDialog(this) == DialogResult.OK)
                    localBox.Text = f.SelectedPath;
            }
        }

        void OpenDestination()
        {
            try
            {
                Directory.CreateDirectory(localBox.Text);
                Process.Start("explorer.exe", localBox.Text);
            }
            catch (Exception ex) { SetStatus(ex.Message, true); }
        }

        void ToggleConnect(bool enabled)
        {
            if (InvokeRequired) { BeginInvoke(new Action<bool>(ToggleConnect), enabled); return; }
            detectBtn.Enabled = enabled;
            connectBtn.Enabled = enabled;
            upBtn.Enabled = enabled;
            refreshBtn.Enabled = enabled;
        }

        void SetStatus(string text, bool error)
        {
            if (InvokeRequired)
            {
                BeginInvoke(new Action<string, bool>(SetStatus), text, error);
                return;
            }

            statusLabel.Text = text;
            statusLabel.ForeColor = error ? Color.Firebrick : Muted;
        }

        Panel Card()
        {
            return new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = Color.White,
                Padding = new Padding(1),
                Margin = new Padding(0)
            };
        }

        Label LabelX(string text, float size, Color color, bool bold)
        {
            return new Label
            {
                Text = text,
                ForeColor = color,
                Font = new Font("Segoe UI", size, bold ? FontStyle.Bold : FontStyle.Regular),
                AutoSize = true,
                BackColor = Color.Transparent
            };
        }

        TextBox Box()
        {
            return new TextBox
            {
                Dock = DockStyle.Fill,
                BorderStyle = BorderStyle.FixedSingle,
                Font = new Font("Segoe UI", 10f),
                Margin = new Padding(0, 4, 8, 3),
                BackColor = Color.White,
                ForeColor = Ink
            };
        }

        Button Btn(string text, Color bg, Color fg)
        {
            var b = new Button
            {
                Text = text,
                BackColor = bg,
                ForeColor = fg,
                FlatStyle = FlatStyle.Flat,
                Dock = DockStyle.Fill,
                Margin = new Padding(4, 3, 4, 3),
                Font = new Font("Segoe UI", 9.2f, FontStyle.Bold),
                Cursor = Cursors.Hand,
                UseVisualStyleBackColor = false
            };
            b.FlatAppearance.BorderSize = 0;
            return b;
        }

        NumericUpDown Num(decimal min, decimal max, decimal value)
        {
            return new NumericUpDown
            {
                Minimum = min,
                Maximum = max,
                Value = value,
                Dock = DockStyle.Fill,
                Margin = new Padding(0, 4, 8, 3),
                Font = new Font("Segoe UI", 10f),
                BackColor = Color.White,
                ForeColor = Ink
            };
        }

        static string NormalizeRemote(string p)
        {
            p = (p ?? "/").Replace('\\', '/');
            if (!p.StartsWith("/")) p = "/" + p;
            while (p.Contains("//")) p = p.Replace("//", "/");
            return p;
        }

        static string RemoteLeaf(string p)
        {
            p = NormalizeRemote(p).TrimEnd('/');
            int i = p.LastIndexOf('/');
            return i >= 0 ? p.Substring(i + 1) : p;
        }

        static string Sanitize(string s)
        {
            if (string.IsNullOrEmpty(s)) return "unnamed";
            foreach (char c in Path.GetInvalidFileNameChars()) s = s.Replace(c, '_');
            s = s.Trim().TrimEnd('.');
            return string.IsNullOrEmpty(s) ? "unnamed" : s;
        }

        static string CompactComponent(string name, int max)
        {
            name = Sanitize(name);
            if (name.Length <= max) return name;

            string ext = "";
            string stem = name;

            try
            {
                ext = Path.GetExtension(name);
                if (ext.Length > 12) ext = "";
                if (!string.IsNullOrEmpty(ext)) stem = name.Substring(0, name.Length - ext.Length);
            }
            catch { ext = ""; stem = name; }

            string h = Hash8(name);
            int keep = Math.Max(6, max - h.Length - ext.Length - 2);
            if (stem.Length > keep) stem = stem.Substring(0, keep);

            return stem + "_" + h + ext;
        }

        static string Hash8(string s)
        {
            unchecked
            {
                uint h = 2166136261;
                foreach (char c in (s ?? ""))
                {
                    h ^= c;
                    h *= 16777619;
                }
                return h.ToString("x8");
            }
        }

        static string FormatBytes(long b)
        {
            if (b < 1024) return b + " B";
            double v = b / 1024d;
            if (v < 1024) return v.ToString("0.0") + " KB";
            v /= 1024d;
            if (v < 1024) return v.ToString("0.0") + " MB";
            return (v / 1024d).ToString("0.00") + " GB";
        }

        static string FormatDuration(double seconds)
        {
            var t = TimeSpan.FromSeconds(Math.Max(0, seconds));
            if (t.TotalHours >= 1) return ((int)t.TotalHours).ToString() + ":" + t.Minutes.ToString("00") + ":" + t.Seconds.ToString("00");
            return t.Minutes.ToString() + ":" + t.Seconds.ToString("00");
        }
    }
}
