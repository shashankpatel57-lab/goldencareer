           var winner = await Task.WhenAny(task, Task.Delay(timeoutMs, token));

            if (winner != task)
            {
                token.ThrowIfCancellationRequested();
                throw new IOException(
                    "No data received for " +
                    (timeoutMs / 1000) +
                    " seconds");
            }

            return await task;
        }

        static async Task ConnectTcpAsync(
            TcpClient client,
            string host,
            int port,
            int timeoutMs,
            CancellationToken token)
        {
            var task = client.ConnectAsync(host, port);
            var winner = await Task.WhenAny(task, Task.Delay(timeoutMs, token));

            if (winner != task)
            {
                try { client.Close(); } catch { }
                token.ThrowIfCancellationRequested();
                throw new IOException("Connection timed out");
            }

            await task;
        }

        static List<FtpItem> ParseMlsd(string text, string parent)
        {
            var items = new List<FtpItem>();

            using (var sr = new StringReader(text ?? ""))
            {
                string line;

                while ((line = sr.ReadLine()) != null)
                {
                    line = line.TrimEnd('\r', '\n');

                    if (line.Length == 0) continue;

                    int space = line.IndexOf(' ');
                    if (space < 0) continue;

                    string facts = line.Substring(0, space);
                    string name = line.Substring(space + 1);

                    if (name.Length == 0 || name == "." || name == "..")
                        continue;

                    bool dir = false;
                    long size = 0;
                    DateTime modified = DateTime.MinValue;

                    string[] fs = facts.Split(';');

                    foreach (string f in fs)
                    {
                        int eq = f.IndexOf('=');
                        if (eq <= 0) continue;

                        string key = f.Substring(0, eq).Trim().ToLowerInvariant();
                        string val = f.Substring(eq + 1).Trim();

                        if (key == "type")
                            dir = val.Equals("dir", StringComparison.OrdinalIgnoreCase);
                        else if (key == "size")
                            long.TryParse(
                                val,
                                NumberStyles.Integer,
                                CultureInfo.InvariantCulture,
                                out size);
                        else if (key == "modify")
                        {
                            DateTime dt;

                            if (DateTime.TryParseExact(
                                val,
                                "yyyyMMddHHmmss",
                                CultureInfo.InvariantCulture,
                                DateTimeStyles.AssumeUniversal |
                                DateTimeStyles.AdjustToUniversal,
                                out dt))
                                modified = dt;
                        }
                    }

                    items.Add(new FtpItem
                    {
                        Name = name,
                        FullPath = CombineRemote(parent, name),
                        IsDirectory = dir,
                        Size = dir ? 0 : size,
                        ModifiedUtc = modified
                    });
                }
            }

            items.Sort((a, b) =>
            {
                if (a.IsDirectory != b.IsDirectory)
                    return a.IsDirectory ? -1 : 1;

                return string.Compare(
                    a.Name,
                    b.Name,
                    StringComparison.OrdinalIgnoreCase);
            });

            return items;
        }

        static string CombineRemote(string parent, string name)
        {
            string p = NormalizeRemote(parent);

            if (p == "/")
                return "/" + name;

            return p.TrimEnd('/') + "/" + name;
        }

        static string NormalizeRemote(string p)
        {
            p = (p ?? "/").Replace('\\', '/');

            if (!p.StartsWith("/"))
                p = "/" + p;

            while (p.Contains("//"))
                p = p.Replace("//", "/");

            return p;
        }

        static void Expect(FtpResponse r, int code)
        {
            if (r.Code != code)
                throw new IOException(
                    "FTP " + code + " expected, got: " + r.Text);
        }

        void EnsureConnected()
        {
            if (control == null ||
                stream == null ||
                writer == null ||
                !control.Connected)
                throw new IOException("FTP session is not connected");
        }

        void DisposeControl()
        {
            turboActive = false;
            packedActive = false;

            try { if (writer != null) writer.Dispose(); } catch { }
            try { if (control != null) control.Close(); } catch { }

            writer = null;
            stream = null;
            control = null;
        }

        public void Dispose()
        {
            try
            {
                if (writer != null)
                {
                    writer.WriteLine("QUIT");
                    writer.Flush();
                }
            }
            catch { }

            DisposeControl();
        }
    }

