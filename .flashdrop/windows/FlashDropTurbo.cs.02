ry != b.IsDirectory)
                    return a.IsDirectory ? -1 : 1;

                return string.Compare(
                    a.Name,
                    b.Name,
                    StringComparison.OrdinalIgnoreCase);
            });

            return items;
        }

        static string CombineRemote(string parent, string name)
        {
            string p = NormalizeRemote(parent);

            if (p == "/")
                return "/" + name;

            return p.TrimEnd('/') + "/" + name;
        }

        static string NormalizeRemote(string p)
        {
            p = (p ?? "/").Replace('\\', '/');

            if (!p.StartsWith("/"))
                p = "/" + p;

            while (p.Contains("//"))
                p = p.Replace("//", "/");

            return p;
        }

        static void Expect(FtpResponse r, int code)
        {
            if (r.Code != code)
                throw new IOException(
                    "FTP " + code + " expected, got: " + r.Text);
        }

        void EnsureConnected()
        {
            if (control == null ||
                stream == null ||
                writer == null ||
                !control.Connected)
                throw new IOException("FTP session is not connected");
        }

        void DisposeControl()
        {
            turboActive = false;

            try { if (writer != null) writer.Dispose(); } catch { }
            try { if (control != null) control.Close(); } catch { }

            writer = null;
            stream = null;
            control = null;
        }

        public void Dispose()
        {
            try
            {
                if (writer != null)
                {
                    writer.WriteLine("QUIT");
                    writer.Flush();
                }
            }
            catch { }

            DisposeControl();
        }
    }

