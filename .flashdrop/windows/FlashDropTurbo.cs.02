ew ProgressBar {
                Dock=DockStyle.Fill,
                Style=ProgressBarStyle.Continuous,
                Maximum=1000,
                Margin=new Padding(0,3,0,5)
            };
            bottom.SetColumnSpan(progress,3);
            bottom.Controls.Add(progress,0,0);

            statusLabel=L("Ready. Adaptive Turbo v1.8 • automatically chooses the fastest compatible LAN path.",9.5f,Muted,false);
            statusLabel.Dock=DockStyle.Fill;
            statusLabel.TextAlign=ContentAlignment.MiddleLeft;
            statusLabel.AutoEllipsis=true;
            bottom.Controls.Add(statusLabel,0,1);

            speedLabel=L("0.0 MB/s",12,Blue,true);
            speedLabel.Dock=DockStyle.Fill;
            speedLabel.TextAlign=ContentAlignment.MiddleRight;
            bottom.Controls.Add(speedLabel,1,1);

            totalLabel=L("Waiting to transfer",9,Muted,false);
            totalLabel.Dock=DockStyle.Fill;
            totalLabel.TextAlign=ContentAlignment.MiddleRight;
            totalLabel.AutoEllipsis=true;
            bottom.Controls.Add(totalLabel,2,1);

            speedTimer = new System.Windows.Forms.Timer { Interval=500 };
            speedTimer.Tick += (s,e)=>UpdateSpeed();

            ResumeLayout(true);
        }

        Panel Card()
        {
            return new Panel { Dock=DockStyle.Fill, BackColor=Color.White, Padding=new Padding(1), Margin=new Padding(0) };
        }

        Label L(string s, float size, Color color, bool bold)
        {
            return new Label { Text=s, ForeColor=color, Font=new Font("Segoe UI",size,bold?FontStyle.Bold:FontStyle.Regular), AutoSize=true, BackColor=Color.Transparent };
        }

        TextBox Box()
        {
            return new TextBox { Dock=DockStyle.Fill, BorderStyle=BorderStyle.FixedSingle, Font=new Font("Segoe UI",10f), Margin=new Padding(0,4,8,3), BackColor=Color.White, ForeColor=Ink };
        }

        Button Btn(string text, Color bg, Color fg)
        {
            var b = new Button { Text=text, BackColor=bg, ForeColor=fg, FlatStyle=FlatStyle.Flat, Dock=DockStyle.Fill, Margin=new Padding(4,3,4,3), Font=new Font("Segoe UI",9.2f,FontStyle.Bold), Cursor=Cursors.Hand, UseVisualStyleBackColor=false };
            b.FlatAppearance.BorderSize=0;
            return b;
        }

        NumericUpDown Num(decimal min, decimal max, decimal value)
        {
            return new NumericUpDown { Minimum=min, Maximum=max, Value=value, Dock=DockStyle.Fill, Margin=new Padding(0,4,8,3), Font=new Font("Segoe UI",10f), BackColor=Color.White, ForeColor=Ink };
        }

        string BaseUrl
        {
            get
            {
                var s=(addressBox.Text??"").Trim().TrimEnd('/');
                if (!s.StartsWith("http://",StringComparison.OrdinalIgnoreCase) && !s.StartsWith("https://",StringComparison.OrdinalIgnoreCase)) s="http://"+s;
                return s;
            }
        }
        string Pin { get { return (pinBox.Text??"").Trim(); } }

        async Task AutoDetectAsync()
        {
            SetStatus("Looking for FlashDrop on your current Wi‑Fi/hotspot…", false);
            detectBtn.Enabled=false;
            try
            {
                var gateways = NetworkInterface.GetAllNetworkInterfaces()
                    .Where(n=>n.OperationalStatus==OperationalStatus.Up)
                    .SelectMany(n=>n.GetIPProperties().GatewayAddresses)
                    .Select(g=>g.Address)
                    .Where(a=>a.AddressFamily==AddressFamily.InterNetwork && !IPAddress.IsLoopback(a))
                    .Select(a=>a.ToString()).Distinct().ToList();
                foreach(var ip in gateways)
                {
                    for(int p=8080;p<=8090;p++)
                    {
                        var u="http://"+ip+":"+p;
                        if(await LooksLikeFlashDrop(u))
                        {
                            addressBox.Text=u;
                            connectionLabel.Text="Phone found";
                            connectionLabel.ForeColor=Green;
                            SetStatus("Phone detected. Enter the 6‑digit PIN shown in FlashDrop, then click Connect.", false);
                            return;
                        }
                    }
                }
                connectionLabel.Text="Not detected"; connectionLabel.ForeColor=Color.FromArgb(180,90,35);
                SetStatus("Auto-detect did not find the phone. Enter the HTTP address shown in the Android app.", true);
            }
            catch(Exception ex){ SetStatus("Detection error: "+ex.Message,true); }
            finally{ detectBtn.Enabled=true; }
        }

        async Task<bool> LooksLikeFlashDrop(string u)
        {
            return await Task.Run(()=>{
                try
                {
                    var req=(HttpWebRequest)WebRequest.Create(u+"/"); req.Method="GET"; req.Timeout=450; req.ReadWriteTimeout=450; req.Proxy=null;
                    using(var res=(HttpWebResponse)req.GetResponse()) using(var sr=new StreamReader(res.GetResponseStream()))
                    {
                         char[] b=new char[2048]; int n=sr.Read(b,0,b.Length); var s=new string(b,0,Math.Max(0,n));
                        return s.IndexOf("FLASHDROP",StringComparison.OrdinalIgnoreCase)>=0;
                    }
                }catch{return false;}
            });
        }

        async Task LoadFolderAsync(string path)
        {
            if(Pin.Length!=6){SetStatus("Enter the 6-digit PIN shown on the phone.",true); return;}
            ToggleConnect(false);
            try
            {
                var r=await GetListAsync(path,CancellationToken.None);
                currentPath=r.path??path??"";
                pathLabel.Text=string.IsNullOrEmpty(currentPath)?"Internal storage":"Internal storage / "+currentPath;
                remoteList.Items.Clear();
                foreach(var x in (r.items??new PhoneItem[0]))
                {
                    var li=new ListViewItem(x.name); li.Tag=x;
                    li.SubItems.Add(x.dir?"Folder":"File");
                    li.SubItems.Add(x.dir?"—":FormatBytes(x.size));
                    li.SubItems.Add(x.modified>0?DateTimeOffset.FromUnixTimeMilliseconds(x.modified).LocalDateTime.ToString("g"):"—");
                    if(x.dir){li.ForeColor=Color.FromArgb(32,74,156); li.Font=new Font(remoteList.Font,FontStyle.Bold);}
                    remoteList.Items.Add(li);
                }
                connectionLabel.Text="Connected"; connectionLabel.ForeColor=Green;
                SetStatus("Connected. Double-click a folder to open it; START TURBO COPY downloads the current folder tree.",false);
            }
            catch(WebException ex)
            {
                connectionLabel.Text="Connection failed"; connectionLabel.ForeColor=Color.Firebrick;
                SetStatus(WebMessage(ex),true);
            }
            catch(Exception ex){SetStatus(ex.Message,true);} finally{ToggleConnect(true);}
        }

        async Task<ListResponse> GetListAsync(string path, CancellationToken token)
        {
            var url=BaseUrl+"/api/list?pin="+Uri.EscapeDataString(Pin)+"&path="+Uri.EscapeDataString(path??"");
            string txt=await GetStringAsync(url,token);
            var r=json.Deserialize<ListResponse>(txt);
            if(r==null) throw new Exception("Invalid response from phone");
            if(!string.IsNullOrEmpty(r.error)) throw new Exception(r.error);
            return r;
        }

