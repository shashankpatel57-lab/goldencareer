    {
                    SetStatus("Connect to the phone first.", true);
                    return;
                }
            }

            if (string.IsNullOrWhiteSpace(localBox.Text))
            {
                SetStatus("Choose a destination folder.", true);
                return;
            }

            transferCts = new CancellationTokenSource();
            var token = transferCts.Token;
            startBtn.Enabled = false;
            cancelBtn.Enabled = true;
            ToggleConnect(false);
            progress.Value = 0;
            completedBytes = 0;
            totalBytes = 0;
            smoothedMbps = 0;

            try
            {
                SetStatus("Scanning phone folder over FTP...", false);

                string rootName = currentPath == "/" ? "PhoneBackup" : CompactComponent(RemoteLeaf(currentPath), 72);
                string destRoot = Path.Combine(localBox.Text, rootName);
                Directory.CreateDirectory(destRoot);

                var files = new List<RemoteFile>();

                using (var scan = new FtpSession(endpoint.Host, endpoint.Port))
                {
                    await scan.ConnectAsync(token);
                    await BuildManifestAsync(scan, currentPath, "", destRoot, files, token);
                }

                totalBytes = files.Sum(f => f.Size);
                totalLabel.Text = files.Count + " files • " + FormatBytes(totalBytes);

                var queue = new ConcurrentQueue<RemoteFile>();
                long already = 0;

                foreach (var f in files)
                {
                    token.ThrowIfCancellationRequested();
                    Directory.CreateDirectory(Path.GetDirectoryName(f.FinalPath));

                    if (f.Size == 0)
                    {
                        if (!File.Exists(f.FinalPath)) File.WriteAllBytes(f.FinalPath, new byte[0]);
                        continue;
                    }

                    if (File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length == f.Size)
                    {
                        already += f.Size;
                        continue;
                    }

                    long part = SafePartLength(f);
                    already += part;
                    queue.Enqueue(f);
                }

                Interlocked.Exchange(ref completedBytes, already);

                if (queue.IsEmpty)
                {
                    progress.Value = 1000;
                    SetStatus("Everything is already copied.", false);
                    return;
                }

                speedSampleBytes = already;
                speedSampleAt = DateTime.UtcNow;
                speedTimer.Start();

                int workers = Math.Max(1, Math.Min((int)workersBox.Value, queue.Count));
                int bufferBytes = (int)bufferBox.Value * 1024 * 1024;
                bufferBytes = Math.Max(512 * 1024, Math.Min(8 * 1024 * 1024, bufferBytes));

                SetStatus(
                    "Turbo 3.1 running — " + workers +
                    " persistent XFD1 streams on FTP port " + endpoint.Port +
                    " • no per-file reconnects.",
                    false);

                var errors = new ConcurrentQueue<string>();
                var tasks = new List<Task>();

                for (int w = 0; w < workers; w++)
                {
                    tasks.Add(Task.Run(async () =>
                    {
                        FtpSession ftp = null;

                        try
                        {
                            RemoteFile file;

                            while (!token.IsCancellationRequested && queue.TryDequeue(out file))
                            {
                                bool ok = false;
                                Exception last = null;

                                for (int attempt = 1; attempt <= 4 && !ok; attempt++)
                                {
                                    try
                                    {
                                        if (ftp == null)
                                        {
                                            ftp = new FtpSession(endpoint.Host, endpoint.Port, true);
                                            await ftp.ConnectAsync(token);
                                        }

                                        long offset = SafePartLength(file);

                                        await ftp.DownloadAsync(
                                            file.RemotePath,
                                            file.PartPath,
                                            file.Size,
                                            offset,
                                            bufferBytes,
                                            token,
                                            n => Interlocked.Add(ref completedBytes, n));

                                        FinalizeFile(file);
                                        ok = true;
                                    }
                                    catch (OperationCanceledException) { throw; }
                                    catch (Exception ex)
                                    {
                                        last = ex;
                                        try { if (ftp != null) ftp.Dispose(); } catch { }
                                        ftp = null;

                                        if (attempt < 4)
                                            Thread.Sleep(250 * attempt);
                                    }
                                }

                                if (!ok)
                                    errors.Enqueue(file.RemotePath + " : " + (last == null ? "transfer failed" : last.Message));
                            }
                        }
                        finally
                        {
                            try { if (ftp != null) ftp.Dispose(); } catch { }
                        }
                    }, token));
                }

                await Task.WhenAll(tasks);
                token.ThrowIfCancellationRequested();

                UpdateSpeed();

                long done = 0;
                foreach (var f in files)
                {
                    if (File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length == f.Size)
                        done += f.Size;
                    else
                        done += SafePartLength(f);
                }

                Interlocked.Exchange(ref completedBytes, done);
                UpdateSpeed();

                if (errors.IsEmpty && done >= totalBytes)
                {
                    progress.Value = 1000;
                    SetStatus("DONE — " + files.Count + " files copied to " + destRoot, false);
                }
                else
                {
                    SetStatus(
                        "Transfer completed with " + errors.Count +
                        " issue(s). Partial files remain resumable. " +
                        (errors.IsEmpty ? "" : errors.FirstOrDefault()),
                        true);
                }
            }
            catch (OperationCanceledException)
            {
                SetStatus("Cancelled. Partial files are preserved for resume.", true);
            }
            catch (Exception ex)
            {
                SetStatus("Transfer stopped: " + ex.Message, true);
            }
            finally
            {
                speedTimer.Stop();
                transferCts.Dispose();
                transferCts = null;
                startBtn.Enabled = true;
                cancelBtn.Enabled = false;
                ToggleConnect(true);
            }
        }

        async Task BuildManifestAsync(
            FtpSession ftp,
            string remote,
            string relative,
            string destRoot,
            List<RemoteFile> files,
            CancellationToken token)
        {
            token.ThrowIfCancellationRequested();

            List<FtpItem> items;

            try
            {
                items = await ftp.ListAsync(remote, token);
            }
            catch
            {
                return;
            }

            foreach (var x in items)
            {
                token.ThrowIfCancellationRequested();

                string safe = CompactComponent(Sanitize(x.Name), 72);
                string rel = string.IsNullOrEmpty(relative) ? safe : Path.Combine(relative, safe);
                string local = Path.Combine(destRoot, rel);

                if (local.Length > 205)
                {
                    string compact = "_" + Hash8(x.FullPath) + "_" + CompactComponent(safe, 42);
                    rel = Path.Combine("_LongPaths", compact);
                    local = Path.Combine(destRoot, rel);
                }

                if (local.Length > 225)
                {
                    string compact = "_" + Hash8(x.FullPath) + "_" + CompactComponent(safe, 22);
                    rel = Path.Combine("_LP", compact);
                    local = Path.Combine(destRoot, rel);
                }

                if (x.IsDirectory)
                {
                    Directory.CreateDirectory(local);
                    await BuildManifestAsync(ftp, x.FullPath, rel, destRoot, files, token);
                }
                else
                {
                    files.Add(new RemoteFile
                    {
                        RemotePath = x.FullPath,
                        FinalPath = local,
                        PartPath = local + ".flashdrop.part",
                        Size = x.Size,
                        ModifiedUtc = x.ModifiedUtc
                    });
                }
            }
        }

        void FinalizeFile(RemoteFile file)
        {
            long size = File.Exists(file.PartPath) ? new FileInfo(file.PartPath).Length : 0;
            if (size != file.Size) throw new IOException("Incomplete local file " + size + "/" + file.Size);

            if (File.Exists(file.FinalPath)) File.Delete(file.FinalPath);
            File.Move(file.PartPath, file.Fin