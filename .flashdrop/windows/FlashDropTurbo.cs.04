                {
                    byte[] hdr=Encoding.UTF8.GetBytes(
                        "FLASHDROP/1\nPIN "+Pin+"\nMODE BENCH\nBYTES "+bytes+"\n\n");
                    await ns.WriteAsync(hdr,0,hdr.Length,token);

                    str