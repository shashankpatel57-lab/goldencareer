iles)
                {
                    token.ThrowIfCancellationRequested();
                    Directory.CreateDirectory(Path.GetDirectoryName(f.FinalPath));

                    if (f.Size == 0)
                    {
                        if (!File.Exists(f.FinalPath))
                            File.WriteAllBytes(f.FinalPath, new byte[0]);
                        continue;
                    }

                    if (File.Exists(f.FinalPath) &&
                        new FileInfo(f.FinalPath).Length == f.Size)
                    {
                        already += f.Size;
                        continue;
                    }

                    long part = SafePartLength(f);
                    already += part;
                    pending.Add(f);
                }

                Interlocked.Exchange(ref completedBytes, already);

                if (pending.Count == 0)
                {
                    progress.Value = 1000;
                    SetStatus("Everything is already copied.", false);
                    return;
                }

                speedSampleBytes = already;
                speedSampleAt = DateTime.UtcNow;
                speedTimer.Start();

                int workers = Math.Max(
                    1,
                    Math.Min((int)workersBox.Value, pending.Count));

                int bufferBytes =
                    (int)bufferBox.Value * 1024 * 1024;

                bufferBytes = Math.Max(
                    512 * 1024,
                    Math.Min(8 * 1024 * 1024, bufferBytes));

                var lanes = new List<List<RemoteFile>>();

                for (int i = 0; i < workers; i++)
                    lanes.Add(new List<RemoteFile>());

                // Round-robin is intentionally used here. For folders with
                // thousands of tiny files it keeps every stream busy instead
                // of allowing one lane to get stuck doing all metadata work.
                for (int i = 0; i < pending.Count; i++)
                    lanes[i % workers].Add(pending[i]);

                SetStatus(
                    "BharatDrop v5 running — " + workers +
                    " packed lanes • automatic reconnect/resume • pause supported.",
                    false);

                var errors = new ConcurrentQueue<string>();
                var tasks = new List<Task>();

                foreach (var lane in lanes)
                {
                    var captured = lane;

                    tasks.Add(Task.Run(async () =>
                    {
                        int cursor = 0;

                        while (cursor < captured.Count)
                        {
                            token.ThrowIfCancellationRequested();

                            int take = Math.Min(
                                500,
                                captured.Count - cursor);

                            var batch = captured.GetRange(
                                cursor,
                                take);

                            bool ok = false;
                            Exception last = null;

                            for (int attempt = 1;
                                 attempt <= 12 && !ok;
                                 attempt++)
                            {
                                FtpSession ftp = null;

                                try
                                {
                                    ftp = new FtpSession(
                                        endpoint.Host,
                                        endpoint.Port,
                                        true,
                                        pinBox.Text.Trim());

                                    await ftp.ConnectAsync(token);

                                    if (!ftp.PackedActive)
                                        throw new IOException(
                                            "Phone server does not support XFD2 packed mode");

                                    await ftp.DownloadBatchAsync(
                                        batch,
                                        bufferBytes,
                                        token,
                                        n => Interlocked.Add(
                                            ref completedBytes,
                                            n),
                                        WaitIfPaused);

                                    ok = true;
                                }
                                catch (OperationCanceledException)
                                {
                                    throw;
                                }
                                catch (Exception ex)
                                {
                                    last = ex;

                                    if (attempt < 12)
                                        Thread.Sleep(Math.Min(3000, 250 * attempt));
                                }
                                finally
                                {
                                    try
                                    {
                                        if (ftp != null)
                                            ftp.Dispose();
                                    }
                                    catch { }
                                }
                            }

                            if (!ok)
                            {
                                // Isolate any stubborn item so one damaged/unreadable
                                // file cannot prevent the rest of the batch from finishing.
                                foreach (var f in batch)
                                {
                                    if (File.Exists(f.FinalPath) &&
                                        new FileInfo(f.FinalPath).Length == f.Size)
                                        continue;

                                    bool recovered = false;
                                    Exception fileLast = last;

                                    for (int r = 1; r <= 6 && !recovered; r++)
                                    {
                                        FtpSession one = null;
                                        try
                                        {
                                            WaitIfPaused();
                                            one = new FtpSession(
                                                endpoint.Host,
                                                endpoint.Port,
                                                true,
                                                pinBox.Text.Trim());

                                            await one.ConnectAsync(token);

                                            await one.DownloadBatchAsync(
                                                new List<RemoteFile> { f },
                                                bufferBytes,
                                                token,
                                                n => Interlocked.Add(ref completedBytes, n),
                                                WaitIfPaused);

                                            recovered =
                                                File.Exists(f.FinalPath) &&
                                                new FileInfo(f.FinalPath).Length == f.Size;
                                        }
                                        catch (OperationCanceledException) { throw; }
                                        catch (Exception ex)
                                        {
                                            fileLast = ex;
                                            if (r < 6)
                                                Thread.Sleep(Math.Min(2500, 350 * r));
                                        }
                                        finally
                                        {
                                            try { if (one != null) one.Dispose(); } catch { }
                                        }
                                    }

                                    if (!recovered)
                                    {
                                        errors.Enqueue(
                                            f.RemotePath + " : " +
                                            (fileLast == null
                                                ? "transfer failed after automatic recovery"
                                                : fileLast.Message));
                                    }
                                }
                            }

                            cursor += take;
                        }
                    }, token));
                }

                await Task.WhenAll(tasks);
                token.ThrowIfCancellationRequested();

                var verifyErrors = new ConcurrentQueue<string>();

                if (verifyCheck.Checked)
                {
                    SetStatus("Transfer complete. Running optional SHA-256 verification…", false);

                    var verifyFiles = files.Where(f =>
                        f.Size > 0 &&
                        File.Exists(f.FinalPath) &&
                        new FileInfo(f.FinalPath).Length == f.Size).ToList();

                    int cursor = 0;

                    using (var verifier = new FtpSession(
                        endpoint.Host,
                        endpoint.Port,
                        false,
                        pinBox.Text.Trim()))
                    {
                        await verifier.ConnectAsync(token);

                        while (cursor < verifyFiles.Count)
                        {
                            WaitIfPaused();
                            int take = Math.Min(250, verifyFiles.Count - cursor);
                            await verifier.VerifyBatchAsync(
                                verifyFiles.GetRange(cursor, take),
                                token,
                                verifyErrors,
                                WaitIfPaused);
                            cursor += take;
                        }
                    }
                }

                UpdateSpeed();

                long done = 0;
                foreach (var f in files)
                {
                    if (File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length == f.Size)
                        done += f.Size;
                    else
                        done += SafePartLength(f);
                }

                Interlocked.Exchange(ref completedBytes, done);
                UpdateSpeed();

                if (reportCheck.Checked)
                    WriteTransferReport(destRoot, files, errors, verifyErrors);

                bool clean = errors.IsEmpty &&
                             verifyErrors.IsEmpty &&
                             done >= totalBytes;

                if (clean)
                {
                    progress.Value = 1000;
                    SetStatus(
                        "DONE — " + files.Count + " files copied" +
                        (verifyCheck.Checked ? " and SHA-256 verified" : "") +
                        ".",
                        false);

                    if (openWhenDoneCheck.Checked)
                        Process.Start("explorer.exe", destRoot);
                }
                else
                {
                    SetStatus(
                        "Finished with " +
                        (errors.Count + verifyErrors.Count) +
                        " issue(s). Resume will continue from partial data next time." +
                        (reportCheck.Checked ? " Report saved in destination." : ""),
                        true);
                }
            }
            catch (OperationCanceledException)
            {
                SetStatus("Cancelled. Partial files are preserved for resume.", true);
            }
            catch (Exception ex)
            {
                SetStatus("Transfer stopped: " + ex.Message, true);
            }
            finally
            {
                speedTimer.Stop();
                transferCts.Dispose();
                transferCts = null;
                pauseGate.Set();
                paused = false;
                startBtn.Enabled = true;
                pauseBtn.Enabled = false;
                pauseBtn.Text = "PAUSE";
                cancelBtn.Enabled = false;
                SetThreadExecutionState(ES_CONTINUOUS);
                ToggleConnect(true);
            }
        }

        void TogglePause()
        {
            if (transferCts == null) return;

            paused = !paused;

            if (paused)
            {
                pauseGate.Reset();
                pauseBtn.Text = "RESUME";
                SetStatus("Paused. Connections are preserved; resume continues from the same data.", false);
            }
            else
            {
                pauseGate.Set();
                pauseBtn.Text = "PAUSE";
                SetStatus("Resuming transfer…", false);
            }
        }

        void WaitIfPaused()
        {
            var cts = transferCts;
            if (cts == null) return;
            pauseGate.Wait(cts.Token);
        }

        void WriteTransferReport(
            string destRoot,
            List<RemoteFile> files,
            ConcurrentQueue<string> errors,
            ConcurrentQueue<string> verifyErrors)
        {
            try
            {
                string report = Path.Combine(
                    destRoot,
                    "BharatDrop_Transfer_Report_" +
                    DateTime.Now.ToString("yyyyMMdd_HHmmss") +
                    ".csv");

                using (var sw = new StreamWriter(report, false, new UTF8Encoding(true)))
                {
                    sw.WriteLine("Status,Remote Path,Local Path,Expected Bytes,Actual Bytes,Details");

                    foreach (var f in files)
                    {
                        long actual = 0;
                        try
                        {
                            if (File.Ex