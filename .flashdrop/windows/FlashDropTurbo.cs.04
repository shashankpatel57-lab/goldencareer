 {
                byte[] buf=new byte[1024*1024];

                while(got<bytes)
                {
                    int n=await ReadWithTimeoutAsync(
                        input,buf,0,(int)Math.Min(buf.Length,bytes-got),token,15000);

                    if(n<=0)break;
                    got+=n;
                }
            }

            sw.Stop();

            if(got!=bytes)
                throw new IOException("LAN benchmark incomplete "+got+"/"+bytes);

            return got/1048576d/Math.Max(.001,sw.Elapsed.TotalSeconds);
        }

        async Task DownloadBundleLaneAsync(
            List<RemoteFile> lane,
            CancellationToken token,
            ConcurrentQueue<string> errors)
        {
            int cursor=0;

            while(cursor<lane.Count)
            {
                token.ThrowIfCancellationRequested();

                var batch=new List<RemoteFile>();
                int bodyEstimate=0;

                while(cursor<lane.Count && batch.Count<400 && bodyEstimate<2*1024*1024)
                {
                    var f=lane[cursor++];
                    batch.Add(f);
                    bodyEstimate+=128+(f.RemotePath==null?0:f.RemotePath.Length*2);
                }

                int attempts=0;

                while(true)
                {
                    token.ThrowIfCancellationRequested();

                    var todo=batch.Where(f=>
                        !(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size))
                        .ToList();

                    if(todo.Count==0)break;

                    attempts++;

                    if(attempts>6)
                    {
                        foreach(var f in todo)
                            errors.Enqueue(f.RemotePath+" : repeated connection interruption");
                        break;
                    }

                    try
                    {
                        await DownloadBundleRequestAsync(todo,token,errors);
                    }
                    catch(OperationCanceledException){throw;}
                    catch(Exception)
                    {
                        Thread.Sleep(250*attempts);
                    }
                }
            }
        }

        async Task DownloadBundleRequestAsync(
            List<RemoteFile> files,
            CancellationToken token,
            ConcurrentQueue<string> errors)
        {
            bool done=false;
            Exception last=null;

            try
            {
                await DownloadBundleV2Async(files,token,errors);
                done=true;
            }
            catch(WebException ex)
            {
                last=ex;
                var r=ex.Response as HttpWebResponse;
                if(r!=null && r.StatusCode!=HttpStatusCode.NotFound)throw;
            }

            if(done)return;

            try
            {
                await DownloadBulkV1Async(files,token,errors);
                done=true;
            }
            catch(WebException ex)
            {
                last=ex;
                var r=ex.Response as HttpWebResponse;
                if(r!=null && r.StatusCode!=HttpStatusCode.NotFound)throw;
            }

            if(done)return;

            SetStatus("Older phone server detected — switching this lane to resumable HTTP file mode.",false);
            await DownloadFilesHttpFallbackAsync(files,token,errors);
        }

        async Task DownloadBundleV2Async(
            List<RemoteFile> files,
            CancellationToken token,
            ConcurrentQueue<string> errors)
        {
            var sb=new StringBuilder(files.Count*128);

            for(int i=0;i<files.Count;i++)
            {
                var f=files[i];
                long offset=SafePartialLength(f);
                string p64=Convert.ToBase64String(Encoding.UTF8.GetBytes(f.RemotePath??""));
                sb.Append(i).Append('\t').Append(offset).Append('\t').Append(p64).Append('\n');
            }

            byte[] body=Encoding.UTF8.GetBytes(sb.ToString());
            string url=BaseUrl+"/api/bundle?pin="+Uri.EscapeDataString(Pin);
            await ReadMultiFileHttpStreamAsync(url,body,files,token,errors,true);
        }

        async Task DownloadBulkV1Async(
            List<RemoteFile> files,
            CancellationToken token,
            ConcurrentQueue<string> errors)
        {
            var sb=new StringBuilder(files.Count*128);

            for(int i=0;i<files.Count;i++)
            {
                var f=files[i];
                long offset=SafePartialLength(f);
                string p64=Convert.ToBase64String(Encoding.UTF8.GetBytes(f.RemotePath??""));
                sb.Append(i).Append('|').Append(offset).Append('|').Append(p64).Append('\n');
            }

            byte[] body=Encoding.UTF8.GetBytes(sb.ToString());
            string url=BaseUrl+"/api/bulk?pin="+Uri.EscapeDataString(Pin);
            await ReadMultiFileHttpStreamAsync(url,body,files,token,errors,false);
        }

        long SafePartialLength(RemoteFile f)
        {
            long offset=0;

            try
            {
                if(File.Exists(f.PartPath))
                {
                    offset=new FileInfo(f.PartPath).Length;

                    if(offset<0 || offset>f.Size)
                    {
                        File.Delete(f.PartPath);
                        offset=0;
                    }
                }
            }
            catch
            {
                offset=0;
            }

            return offset;
        }

        async Task ReadMultiFileHttpStreamAsync(
            string url,
            byte[] body,
            List<RemoteFile> files,
            CancellationToken token,
            ConcurrentQueue<string> errors,
            bool tabs)
        {
            var req=(HttpWebRequest)WebRequest.Create(url);
            req.Method="POST";
            req.ContentType="text/plain; charset=utf-8";
            req.ContentLength=body.Length;
            req.Proxy=null;
            req.KeepAlive=true;
            req.Timeout=30000;
            req.ReadWriteTimeout=30000;
            req.SendChunked=false;

            using(token.Register(()=>{try{req.Abort();}catch{}}))
            {
                using(var rs=await req.GetRequestStreamAsync())
                    await rs.WriteAsync(body,0,body.Length,token);

                using(var res=(HttpWebResponse)await req.GetResponseAsync())
                using(var input=res.GetResponseStream())
                {
                    while(true)
                    {
                        token.ThrowIfCancellationRequested();

                        string line=await ReadAsciiLineWithTimeoutAsync(input,token,20000);

                        if(string.IsNullOrEmpty(line))
                            throw new IOException("Transfer stream ended unexpectedly");

                        if(line=="DONE")break;

                        string[] p=tabs
                            ? line.Split('\t')
                            : line.Split(new[]{' '},StringSplitOptions.RemoveEmptyEntries);

                        if(p.Length>=3 && p[0]=="ERR")
                        {
                            int bad;
                            if(int.TryParse(p[1],out bad) && bad>=0 && bad<files.Count)
                                errors.Enqueue(files[bad].RemotePath+" : "+p[2]);
                            continue;
                        }

                        if(p.Length<4 || p[0]!="FILE")
                            throw new IOException("Invalid Turbo frame: "+line);

                        int index=int.Parse(p[1]);
                        long remaining=long.Parse(p[2]);
                        long size=long.Parse(p[3]);

                        if(index<0 || index>=files.Count)
                            throw new IOException("Invalid Turbo file index");

                        await ReceiveOneFramedFileAsync(
                            input,files[index],remaining,size,token);
                    }
                }
            }
        }

        async Task ReceiveOneFramedFileAsync(
            Stream input,
            RemoteFile file,
            long remaining,
            long size,
            CancellationToken token)
        {
            long offset=size-remaining;
            int bufferBytes=(int)chunkBox.Value*1024*1024;
            bufferBytes=Math.Max(512*1024,Math.Min(8*1024*1024,bufferBytes));
            byte[] buf=new byte[bufferBytes];

            Directory.CreateDirectory(Path.GetDirectoryName(file.FinalPath));

            using(var fs=new FileStream(
                file.PartPath,
                FileMode.OpenOrCreate,
                FileAccess.Write,
                FileShare.Read,
                bufferBytes,
                FileOptions.SequentialScan | FileOptions.Asynchronous))
            {
                fs.Seek(offset,SeekOrigin.Begin);
                if(fs.Length!=offset)fs.SetLength(offset);

    