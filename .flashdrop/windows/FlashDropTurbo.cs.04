m;
            if(x!=null && x.dir) await LoadFolderAsync(x.path);
        }

        async Task UpAsync()
        {
            if(string.IsNullOrEmpty(currentPath)){await LoadFolderAsync("");return;}
            var p=currentPath.Replace('\\','/'); int i=p.LastIndexOf('/'); p=i<0?"":p.Substring(0,i); await LoadFolderAsync(p);
        }

        void ChooseFolder()
        {
            using(var f=new FolderBrowserDialog { Description="Choose where FlashDrop should save the phone folder", ShowNewFolderButton=true, SelectedPath=Directory.Exists(localBox.Text)?localBox.Text:"" })
                if(f.ShowDialog(this)==DialogResult.OK)localBox.Text=f.SelectedPath;
        }

        void OpenDestination()
        {
            try{Directory.CreateDirectory(localBox.Text);Process.Start("explorer.exe",localBox.Text);}catch(Exception ex){SetStatus(ex.Message,true);}
        }

        async Task StartTransferAsync()
        {
            if(cts!=null){return;}
            if(Pin.Length!=6){SetStatus("Enter the PIN and connect first.",true);return;}
            if(string.IsNullOrWhiteSpace(localBox.Text)){SetStatus("Choose a destination folder on the PC.",true);return;}
            cts=new CancellationTokenSource(); var token=cts.Token;
            startBtn.Enabled=false; cancelBtn.Enabled=true; ToggleConnect(false); completedBytes=0; totalBytes=0; progress.Value=0;
            transferWatch=Stopwatch.StartNew(); speedTimer.Start();
            try
            {
                SetStatus("Scanning the selected phone folder…",false);
                var remoteRoot=currentPath??"";
                string rootName=string.IsNullOrEmpty(remoteRoot)?"PhoneBackup":Sanitize(RemoteLeaf(remoteRoot));
                string destination=Path.Combine(localBox.Text,rootName);
                Directory.CreateDirectory(destination);
                 var files=new List<RemoteFile>();
                await BuildManifestAsync(remoteRoot,"",destination,files,token);
                totalBytes=files.Sum(f=>f.Size);
                totalLabel.Text=files.Count+" files • "+FormatBytes(totalBytes);
                if(files.Count==0){SetStatus("No readable files found in this folder.",true);return;}

                int workers=(int)workersBox.Value;
                long chunk=(long)chunkBox.Value*1024L*1024L;
                var jobs=new ConcurrentQueue<ChunkJob>();
                long alreadyDone=0;
                foreach(var f in files)
                {
                    token.ThrowIfCancellationRequested();
                    Directory.CreateDirectory(Path.GetDirectoryName(f.FinalPath));
                    if(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size)
                    {
                        alreadyDone+=f.Size; continue;
                    }
                    if(f.Size==0){File.WriteAllBytes(f.FinalPath,new byte[0]);continue;}
                    try{if(File.Exists(f.PartPath))File.Delete(f.PartPath);}catch{}
                    using(var fs=new FileStream(f.PartPath,FileMode.Create,FileAccess.Write,FileShare.ReadWrite)){fs.SetLength(f.Size);}
                    int count=(int)Math.Ceiling(f.Size/(double)chunk); f.RemainingChunks=count;
                    for(long st=0;st<f.Size;st+=chunk) jobs.Enqueue(new ChunkJob{File=f,Start=st,End=Math.Min(f.Size-1,st+chunk-1)});
                }
                Interlocked.Exchange(ref completedBytes,alreadyDone);
                if(jobs.IsEmpty){SetStatus("Everything is already present at the destination.",false);progress.Value=1000;return;}
                SetStatus("Turbo transfer running — "+workers+" parallel workers, "+chunkBox.Value+" MB ranges.",false);

                var errors=new ConcurrentQueue<string>();
                var tasks=new List<Task>();
                for(int i=0;i<workers;i++) tasks.Add(Task.Run(async()=>{
                    ChunkJob job;
                    while(!token.IsCancellationRequested && jobs.TryDequeue(out job))
                    {
                        bool ok=false; Exception last=null;
                        for(int attempt=1;attempt<=3 && !ok && !token.IsCancellationRequested;attempt++)
                        {
                            try{await DownloadChunkAsync(job,token);ok=true;}catch(Exception ex){last=ex;Thread.Sleep(250*attempt);}
                        }
                        if(!ok){errors.Enqueue(job.File.RemotePath+" : "+(last==null?"transfer failed":last.Message)); continue;}
                        if(Interlocked.Decrement(ref job.File.RemainingChunks)==0)
                        {
                            try
                            {
                                if(File.Exists(job.File.FinalPath))File.Delete(job.File.FinalPath);
                                File.Move(job.File.PartPath,job.File.FinalPath);
                                if(job.File.Modified>0)File.SetLastWriteTime(job.File.FinalPath,DateTimeOffset.FromUnixTimeMilliseconds(job.File.Modified).LocalDateTime);
                            }catch(Exception ex){errors.Enqueue(job.File.RemotePath+" : "+ex.Message);}
                        }
                    }
                },token));
                await Task.WhenAll(tasks);
                token.ThrowIfCancellationRequested();
                progress.Value=1000; UpdateSpeed();
                if(errors.IsEmpty) SetStatus("DONE — "+files.Count+" files copied to "+destination,false);
                else SetStatus("Completed with "+errors.Count+" error(s). First