rue;
                                    }
                                    catch(Exception ex)
                                    {
                                        last=ex;
                                        session.Close();
                                        Thread.Sleep(250*attempt);
                                    }
                                }

                                if(!ok)
                                {
                                    errors.Enqueue(file.RemotePath+" : "+(last==null?"transfer failed":last.Message));
                                    continue;
                                }

                                try
                                {
                                    long got=File.Exists(file.PartPath)?new FileInfo(file.PartPath).Length:0;
                                    if(got!=file.Size)throw new IOException("Incomplete file "+got+"/"+file.Size);

                                    if(File.Exists(file.FinalPath))File.Delete(file.FinalPath);
                                    File.Move(file.PartPath,file.FinalPath);

                                    if(file.Modified>0)
                                        File.SetLastWriteTime(
                                            file.FinalPath,
                                            DateTimeOffset.FromUnixTimeMilliseconds(file.Modified).LocalDateTime);
                                }
                                catch(Exception ex)
                                {
                                    errors.Enqueue(file.RemotePath+" : "+ex.Message);
                                }
                            }
                        }
                    },token));
                }

                await Task.WhenAll(tasks);
                token.ThrowIfCancellationRequested();
                progress.Value=1000;
                UpdateSpeed();

                if(errors.IsEmpty)SetStatus("DONE — "+files.Count+" files copied to "+destination,false);
                else SetStatus("Completed with "+errors.Count+" error(s). First: "+errors.FirstOrDefault(),true);
            }
            catch(OperationCanceledException)
            {
                SetStatus("Transfer cancelled. Partial files are kept and will resume next time.",true);
            }
            catch(Exception ex)
            {
                SetStatus("Transfer stopped: "+ex.Message+"  Partial files are preserved for resume.",true);
            }
            finally
            {
                speedTimer.Stop();
                if(transferWatch!=null)transferWatch.Stop();
                cts.Dispose();
                cts=null;
                startBtn.Enabled=true;
                cancelBtn.Enabled=false;
                ToggleConnect(true);
            }
        }

        async Task BuildManifestAsync(string remote,string rel,string destRoot,List<RemoteFile> files,CancellationToken token)
        {
            token.ThrowIfCancellationRequested();
            var list=await GetListAsync(remote,token);

            foreach(var x in (list.items??new PhoneItem[0]))
            {
                token.ThrowIfCancellationRequested();

                string original=Sanitize(x.name);
                string safe=CompactComponent(original,72);
                string childRel=string.IsNullOrEmpty(rel)?safe:Path.Combine(rel,safe);

                // Leave headroom for ".flashdrop.part" and old .NET/Win32 MAX_PATH behavior.
                string candidate=Path.Combine(destRoot,childRel);
                if(candidate.Length>205)
                {
                    string compact="_"+Hash8(x.path)+"_"+CompactComponent(original,44);
                    childRel=Path.Combine("_LongPaths",compact);
                    candidate=Path.Combine(destRoot,childRel);
                }

                if(candidate.Length>225)
                {
                    string compact="_"+Hash8(x.path)+"_"+CompactComponent(original,24);
                    childRel=Path.Combine("_LP",compact);
                    candidate=Path.Combine(destRoot,childRel);
                }

                if(x.dir)
                {
                    Directory.CreateDirectory(candidate);
                    await BuildManifestAsync(x.path,childRel,destRoot,files,token);
                }
                else
                {
                    var final=candidate;
                    files.Add(new RemoteFile{
                        RemotePath=x.path,
                        RelativePath=childRel,
                        Size=Math.Max(0,x.size),
                        Modified=x.modified,
                        FinalPath=final,
                        PartPath=final+".flashdrop.part"
                    });
                }
            }
        }

        static string CompactComponent(string name,int max)
        {
            if(string.IsNullOrEmpty(name))return "unnamed";
            if(max<18)max=18;
            if(name.Length<=max)return name;

            string ext="";
            string stem=name;
            try
            {
                ext=Path.GetExtension(name);
                if(ext.Length>12)ext="";
                if(!string.IsNullOrEmpty(ext))stem=name.Substring(0,name.Length-ext.Length);
            }
            catch { ext=""; stem=name; }

            string hash=Hash8(name);
            int keep=Math.Max(6,max-hash.Length-ext.Length-2);
            if(stem.Length>keep)stem=stem.Substring(0,keep);
            return stem+"_"+hash+ext;
        }

        static string Hash8(string s)
        {
            unchecked
            {
                uint h=2166136261;
                foreach(char c in (s??""))
                {
                    h^=c;
                    h*=16777619;
                }
                return h.ToString("x8");
            }
        }

        int TurboPort
        {
            get { return 9091; }
        }

        string TurboHost
        {
            get { return new Uri(BaseUrl).Host; }
        }

        async Task<double> RunTurboBenchmarkAsync(long bytes,CancellationToken token)
        {
            var sw=Stopwatch.StartNew();
            using(var client=new TcpClient())
            {
                client.NoDelay=true;
                client.ReceiveBufferSize=4*1024*1024;
                await client.ConnectAsync(TurboHost,TurboPort);
                using(var ns=client.GetStream())
                using(token.Register(()=>{try{client.Close();}catch{}}))
                {
                    byte[] hdr=Encoding.UTF8.GetBytes(
                        "FLASHDROP/1\nPIN "+Pin+"\nMODE BENCH\nBYTES "+bytes+"\n\n");
                    await ns.WriteAsync(hdr,0,hdr.Length,token);

                    string line=await ReadAsciiLineAsync(ns,token);
                    if(!line.StartsWith("OK "))throw new IOException("Turbo server: "+line);

                    byte[] buf=new byte[1024*1024];
                    long got=0;
                    while(got<bytes)
                    {
                        int n=await ReadWithTimeoutAsync(ns,buf,0,(int)Math.Min(buf.Length,bytes-got),token,12000);
                        if(n<=0)break;
                        got+=n;
                    }
                    if(got!=bytes)throw new IOException("Turbo benchmark short read");
                }
            }
            sw.Stop();
            return bytes