";
                connectionLabel.ForeColor = Green;
                SetStatus("Connected through the stable FTP engine. Double-click a folder or start copying the current folder tree.", false);
            }
            finally
            {
                ToggleConnect(true);
            }
        }

        async Task OpenSelectedAsync()
        {
            if (remoteList.SelectedItems.Count == 0) return;
            var x = remoteList.SelectedItems[0].Tag as FtpItem;
            if (x != null && x.IsDirectory) await LoadFolderAsync(x.FullPath);
        }

        async Task UpAsync()
        {
            string p = NormalizeRemote(currentPath);
            if (p == "/") { await LoadFolderAsync("/"); return; }

            p = p.TrimEnd('/');
            int i = p.LastIndexOf('/');
            p = i <= 0 ? "/" : p.Substring(0, i);
            await LoadFolderAsync(p);
        }

        async Task StartTransferAsync()
        {
            if (transferCts != null) return;

            if (endpoint == null)
            {
                endpoint = await ResolveEndpointAsync(addressBox.Text);
                if (endpoint == null)
                {
                    SetStatus("Connect to the phone first.", true);
                    return;
                }
            }

            if (string.IsNullOrWhiteSpace(localBox.Text))
            {
                SetStatus("Choose a destination folder.", true);
                return;
            }

            transferCts = new CancellationTokenSource();
            var token = transferCts.Token;
            startBtn.Enabled = false;
            cancelBtn.Enabled = true;
            ToggleConnect(false);
            progress.Value = 0;
            completedBytes = 0;
            totalBytes = 0;
            smoothedMbps = 0;

            try
            {
                SetStatus("Scanning phone folder over FTP...", false);

                string rootName = currentPath == "/" ? "PhoneBackup" : CompactComponent(RemoteLeaf(currentPath), 72);
                string destRoot = Path.Combine(localBox.Text, rootName);
                Directory.CreateDirectory(destRoot);

                var files = new List<RemoteFile>();

                using (var scan = new FtpSession(endpoint.Host, endpoint.Port, false))
                {
                    await scan.ConnectAsync(token);
                    await BuildManifestAsync(scan, currentPath, "", destRoot, files, token);
                }

                totalBytes = files.Sum(f => f.Size);
                totalLabel.Text = files.Count + " files • " + FormatBytes(totalBytes);

                var pending = new List<RemoteFile>();
                long already = 0;

                foreach (var f in files)
                {
                    token.ThrowIfCancellationRequested();
                    Directory.CreateDirectory(Path.GetDirectoryName(f.FinalPath));

                    if (f.Size == 0)
                    {
                        if (!File.Exists(f.FinalPath))
                            File.WriteAllBytes(f.FinalPath, new byte[0]);
                        continue;
                    }

                    if (File.Exists(f.FinalPath) &&
                        new FileInfo(f.FinalPath).Length == f.Size)
                    {
                        already += f.Size;
                        continue;
                    }

                    long part = SafePartLength(f);
                    already += part;
                    pending.Add(f);
                }

                Interlocked.Exchange(ref completedBytes, already);

                if (pending.Count == 0)
                {
                    progress.Value = 1000;
                    SetStatus("Everything is already copied.", false);
                    return;
                }

                speedSampleBytes = already;
                speedSampleAt = DateTime.UtcNow;
                speedTimer.Start();

                int workers = Math.Max(
                    1,
                    Math.Min((int)workersBox.Value, pending.Count));

                int bufferBytes =
                    (int)bufferBox.Value * 1024 * 1024;

                bufferBytes = Math.Max(
                    512 * 1024,
                    Math.Min(8 * 1024 * 1024, bufferBytes));

                var lanes = new List<List<RemoteFile>>();

                for (int i = 0; i < workers; i++)
                    lanes.Add(new List<RemoteFile>());

                // Round-robin is intentionally used here. For folders with
                // thousands of tiny files it keeps every stream busy instead
                // of allowing one lane to get stuck doing all metadata work.
                for (int i = 0; i < pending.Count; i++)
                    lanes[i % workers].Add(pending[i]);

                SetStatus(
                    "Turbo 4 running — " + workers +
                    " XFD2 packed lanes • up to 500 files per batch • no per-file network transaction.",
                    false);

                var errors = new ConcurrentQueue<string>();
                var tasks = new List<Task>();

                foreach (var lane in lanes)
                {
                    var captured = lane;

                    tasks.Add(Task.Run(async () =>
                    {
                        int cursor = 0;

                        while (cursor < captured.Count)
                        {
                            token.ThrowIfCancellationRequested();

                            int take = Math.Min(
                                500,
                                captured.Count - cursor);

                            var batch = captured.GetRange(
                                cursor,
                                take);

                            bool ok = false;
                            Exception last = null;

                            for (int attempt = 1;
                                 attempt <= 4 && !ok;
                                 attempt++)
                            {
                                FtpSession ftp = null;

                                try
                                {
                                    ftp = new FtpSession(
                                        endpoint.Host,
                                        endpoint.Port,
                                        true);

                                    await ftp.ConnectAsync(token);

                                    if (!ftp.PackedActive)
                                        throw new IOException(
                                            "Phone server does not support XFD2 packed mode");

                                    await ftp.DownloadBatchAsync(
                                        batch,
                                        bufferBytes,
                                        token,
                                        n => Interlocked.Add(
                                            ref completedBytes,
                                            n));

                                    ok = true;
                                }
                                catch (OperationCanceledException)
                                {
                                    throw;
                                }
                                catch (Exception ex)
                                {
                                    last = ex;

                                    if (attempt < 4)
                                        Thread.Sleep(250 * attempt);
                                }
                                finally
                                {
                                    try
                                    {
                                        if (ftp != null)
                                            ftp.Dispose();
                                    }
                                    catch { }
                                }
                            }

                            if (!ok)
                            {
                                foreach (var f in batch)
                                {
                                    if (!(File.Exists(f.FinalPath) &&
                                          new FileInfo(f.FinalPath).Length == f.Size))
                                    {
                                        errors.Enqueue(
                                            f.RemotePath + " : " +
                                            (last == null
                                                ? "packed transfer failed"
                                                : last.Message));
                                    }
                                }
                            }

                            cursor += take;
                        }
                    }, token));
                }

                await Task.WhenAll(tasks);
                token.ThrowIfCancellationRequested();

                UpdateSpeed();

                long done = 0;
                foreach (var f in files)
                {
                    if (File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length == f.Size)
                        done += f.Size;
                    else
                        done += SafePartLength(f);
                }

                Interlocked.Exchange(ref completedBytes, done);
                UpdateSpeed();

                if (errors.IsEmpty && done >= totalBytes)
                {
                    progress.Value = 1000;
                    SetStatus("DONE — " + files.Count + " files copied to " + destRoot, false);
                }
                else
                {
                    SetStatus(
                        "Transfer completed with " + errors.Count +
                        " issue(s). Partial files remain resumable. " +
                        (errors.IsEmpty ? "" : errors.FirstOrDefault()),
                        true);
                }
            }
            catch (OperationCanceledException)
            {
                SetStatus("Cancelled. Partial files are preserved for resume.", true);
            }
            catch (Exception ex)
            {
                SetStatus("Transfer stopped: " + ex.Message, true);
            }
            finally
            {
                speedTimer.Stop();
                transferCts.Dispose();
                transferCts = null;
                startBtn.Enabled = true;
                cancelBtn.Enabled = false;
                ToggleConnect(true);
            }
        }

        async Task BuildManifestAsync(
            FtpSession ftp,
            string remote,
            string relative,
            string destRoot,
            List<RemoteFile> files,
            CancellationToken token)
        {
            token.ThrowIfCancellationRequested();

            List<FtpItem> items;

            try
            {
                items = await ftp.ListAsync(remote, token);
            }
            catch
            {
                return;
            }

            foreach (var x in items)
            {
                token.ThrowIfCancellationRequested();

                string safe = CompactComponent(Sanitize(x.Name), 72);
                string rel = string.IsNullOrEmpty(relative) ? safe : Path.Combine(relative, safe);
                string local = Path.Combine(destRoot, rel);

                if (local.Length > 205)
                {
                    string compact = "_" + Hash8(x.FullPath) + "_" + CompactComponent(safe, 42);
             