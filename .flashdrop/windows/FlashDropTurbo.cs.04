turn Math.Max(0,f.Size-partial);
        }

        async Task BuildManifestAsync(string remote,string rel,string destRoot,List<RemoteFile> files,CancellationToken token)
        {
            token.ThrowIfCancellationRequested();
            var list=await GetListAsync(remote,token);

            foreach(var x in (list.items??new PhoneItem[0]))
            {
                token.ThrowIfCancellationRequested();

                string original=Sanitize(x.name);
                string safe=CompactComponent(original,72);
                string childRel=string.IsNullOrEmpty(rel)?safe:Path.Combine(rel,safe);

                string candidate=Path.Combine(destRoot,childRel);

                if(candidate.Length>205)
                {
                    string compact="_"+Hash8(x.path)+"_"+CompactComponent(original,44);
                    childRel=Path.Combine("_LongPaths",compact);
                    candidate=Path.Combine(destRoot,childRel);
                }

                if(candidate.Length>225)
                {
                    string compact="_"+Hash8(x.path)+"_"+CompactComponent(original,24);
                    childRel=Path.Combine("_LP",compact);
                    candidate=Path.Combine(destRoot,childRel);
                }

                if(x.dir)
                {
                    Directory.CreateDirectory(candidate);
                    await BuildManifestAsync(x.path,childRel,destRoot,files,token);
                }
                else
                {
                    files.Add(new RemoteFile{
                        RemotePath=x.path,
                        RelativePath=childRel,
                        Size=Math.Max(0,x.size),
                        Modified=x.modified,
                        FinalPath=candidate,
                        PartPath=candidate+".flashdrop.part"
                    });
                }
            }
        }

        static string CompactComponent(string name,int max)
        {
            if(string.IsNullOrEmpty(name))return "unnamed";
            if(max<18)max=18;
            if(name.Length<=max)return name;

            string ext="";
            string stem=name;

            try
            {
                ext=Path.GetExtension(name);
                if(ext.Length>12)ext="";
                if(!string.IsNullOrEmpty(ext))stem=name.Substring(0,name.Length-ext.Length);
            }
            catch
            {
                ext="";
                stem=name;
            }

            string hash=Hash8(name);
            int keep=Math.Max(6,max-hash.Length-ext.Length-2);

            if(stem.Length>keep)stem=stem.Substring(0,keep);

            return stem+"_"+hash+ext;
        }

        static string Hash8(string s)
        {
            unchecked
            {
                uint h=2166136261;

                foreach(char c in (s??""))
                {
                    h^=c;
                    h*=16777619;
                }

                return h.ToString("x8");
            }
        }

        async Task<double> RunHttpBenchmarkAsync(long bytes,CancellationToken token)
        {
            string url=BaseUrl+"/api/bench?pin="+Uri.EscapeDataString(Pin)+"&bytes="+bytes;
            var req=(HttpWebRequest)WebRequest.Create(url);
            req.Method="GET";
            req.Proxy=null;
            req.KeepAlive=true;
            req.Timeout=15000;
            req.ReadWriteTimeout=15000;

            var sw=Stopwatch.StartNew();
            long got=0;

            using(token.Register(()=>{try{req.Abort();}catch{}}))
            using(var res=(HttpWebResponse)await req.GetResponseAsync())
            using(var input=res.GetResponseStream())
            {
                byte[] buf=new byte[1024*1024];

                while(got<bytes)
                {
                    int n=await ReadWithTimeoutAsync(
                        input,buf,0,(int)Math.Min(buf.Length,bytes-got),token,15000);

                    if(n<=0)break;
                    got+=n;
                }
            }

            sw.Stop();

            if(got!=bytes)
                throw new IOException("LAN benchmark incomplete "+got+"/"+bytes);

            return got/1048576d/Math.Max(.001,sw.Elapsed.TotalSeconds);
        }

        async Task DownloadBundleLaneAsync(
            List<RemoteFile> lane,
            CancellationToken token,
            ConcurrentQueue<string> errors)
        {
            int cursor=0;

            while(cursor<lane.Count)
            {
                token.ThrowIfCancellationRequested();

                var batch=new List<RemoteFile>();
                int bodyEstimate=0;

                while(cursor<lane.Count && batch.Count<400 && bodyEstimate<2*1024*1024)
                {
                    var f=lane[cursor++];
                    batch.Add(f);
                    bodyEstimate+=128+(f.RemotePath==null?0:f.RemotePath.Length*2);
                }

                int attempts=0;

                while(true)
                {
                    token.ThrowIfCancellationRequested();

                    var todo=batch.Where(f=>
                        !(File.Exists(f.FinalPath) && new FileInfo(f.FinalPath).Length==f.Size))
                        .ToList();

                    if(todo.Count==0)break;

                    attempts++;

                    if(attempts>6)
                    {
                        foreach(var f in todo)
                            errors.Enqueue(f.RemotePath+" : repeated connection interruption");
                        break;
                    }

                    try
                    {
                        await DownloadBundleRequestAsync(todo,token,errors);
                    }
                    catch(OperationCanceledException){throw;}
                    catch(Exception)
                    {
                        await Task.Delay(250*attempts,token);
                    }
                }
            }
        }

        async Task DownloadBundleRequestAsync(
            List<RemoteFile> files,
            CancellationToken token,
            ConcurrentQueue<string> errors)
        {
            var sb=new StringBuilder(files.Count*128);

            for(int i=0;i<files.Count;i++)
            {
                var f=files[i];
                long offset=0;

                try
                {
                    if(File.Exists(f.PartPath))
                    {
                        offset=new FileInfo(f.PartPath).Length;

                        if(offset<0 || offset>f.Size)
                        {
                            File.Delete(f.PartPath);
                            offset=0;
                        }
                    }
                }
                catch
                {
                    offset=0;
                }

                string p64=Convert.ToBase64String(Encoding.UTF8.GetBytes(f.RemotePath??""));
                sb.Append(i).Append('\t').Append(offset).Append('\t').Append(p64).Append('\n');
            }

            byte[] body=Encoding.UTF8.GetBytes(sb.ToString());
            string url=BaseUrl+"/api/bundle?pin="+Uri.EscapeDataString(Pin);

            var req=(HttpWebRequest)WebRequest.Create(url);
            req.Method="POST";
            req.ContentType="text/plain; charset=utf-8";
            req.ContentLength=body.Length;
            req.Proxy=null;
            req.KeepAlive=true;
            req.Timeout=30000;
            req.ReadWriteTimeout=30000;
            req.SendChunked=false;

            using(token.Register(()=>{try{req.Abort();}catch{}}))
            {
                using(var rs=await req.GetRequestStreamAsync())
                    await rs.WriteAsync(body,0,body.Length,token);

                using(var res=(HttpWebResponse)await req.GetResponseAsync())
                using(var input=res.GetResponseStream())
                {
                    while(true)
                    {
                        token.ThrowIfCancellationRequested();

                        string line=await ReadAsciiLineWithTimeoutAsync(input,token,20000);

                