:closeCourse)
        else when(tab){MainTab.HOME->HomeScreen(ui,vm::openCourse,{tab=MainTab.COURSES},{tab=MainTab.RESOURCES},vm::refreshAll);MainTab.COURSES->MyCoursesScreen(ui,vm::openCourse,vm::loadMyCourses);MainTab.LIVE->LiveScreen(ui,vm::loadLive);MainTab.RESOURCES->ResourcesScreen(ui,onOpenLesson,vm::loadNewspapers);MainTab.CHAT->ChatScreen(vm,ui)}
        if(ui.busy)Box(Modifier.fillMaxSize().background(Color.Black.copy(alpha=.08f)),contentAlignment=Alignment.Center){CircularProgressIndicator()}
    }}
    if(showProfile)ProfileDialog(ui,{showProfile=false},vm::logout)
    if(showNotifications)NotificationsDialog(ui,{showNotifications=false})
    when(val lesson=ui.selectedLesson){is LoadState.Data->TextLessonDialog(lesson.value,{vm.markComplete(lesson.value.lesson?.id?:0);vm.closeLesson()},vm::closeLesson);is LoadState.Error->AlertDialog(onDismissRequest=vm::closeLesson,confirmButton={TextButton(onClick=vm::closeLesson){Text("Close")}},title={Text("Lesson")},text={Text(lesson.message)});else->Unit}
}

@Composable private fun LogoMark(size:Int){Box(Modifier.size(size.dp).clip(RoundedCornerShape((size*.28).dp)).background(Brush.linearGradient(listOf(Navy2,Navy3))),contentAlignment=Alignment.Center){Text("GC",color=GoldSoft,fontWeight=FontWeight.Black,fontSize=(size*.34).sp)}}

@Composable private fun HomeScreen(ui:AppUiState,onCourse:(Long)->Unit,onMyCourses:()->Unit,onResources:()->Unit,onRefresh:()->Unit){
    when(val h=ui.home){is LoadState.Error->StateError(h.message,onRefresh);is LoadState.Loading->Loading();is LoadState.Data->{val home=h.value;LazyColumn(contentPadding=PaddingValues(bottom=22.dp)){
        item{HomeHero(ui.user?.name?:"Student")}
        if(home.my_courses.isNotEmpty())item{SectionTitle("Continue learning","Your active courses",action="My Courses",onAction=onMyCourses)}
        if(home.my_courses.isNotEmpty())item{LazyRow(contentPadding=PaddingValues(horizontal=18.dp),horizontalArrangement=Arrangement.spacedBy(10.dp)){items(home.my_courses){c->ContinueCard(c){onCourse(c.id)}}}}
        item{SectionTitle("Explore Golden Career","Everything in one learning platform")}
        item{CategoryGrid(home.categories,onResources)}
        val paid=home.courses.filter{it.course_type=="paid"}.take(8);if(paid.isNotEmpty())item{SectionTitle("Interview courses","Focused batches for final selection")};if(paid.isNotEmpty())item{LazyRow(contentPadding=PaddingValues(horizontal=18.dp),horizontalArrangement=Arrangement.spacedBy(12.dp)){items(paid){c->CourseCard(c){onCourse(c.id)}}}}
        if(home.live_classes.isNotEmpty())item{SectionTitle("Upcoming live classes","Stay ready for your next session")};items(home.live_classes.take(3)){l->LiveCard(l)}
        if(home.newspapers.isNotEmpty())item{SectionTitle("Today's newspaper","English & Hindi resources",action="Open",onAction=onResources)}
        val free=home.courses.filter{it.course_type=="free"}.take(6);if(free.isNotEmpty())item{SectionTitle("Start free","Explore before you buy")};if(free.isNotEmpty())item{LazyRow(contentPadding=PaddingValues(horizontal=18.dp),horizontalArrangement=Arrangement.spacedBy(12.dp)){items(free){c->CourseCard(c){onCourse(c.id)}}}}
    }};else->Loading()}
}

@Composable private fun HomeHero(name:String){
    Box(Modifier.fillMaxWidth().padding(14.dp).height(220.dp).clip(RoundedCornerShape(26.dp)).background(Brush.linearGradient(listOf(Navy,Navy3)))){
        Box(Modifier.size(190.dp).align(Alignment.TopEnd).offset(65.dp,-75.dp).clip(CircleShape).background(Gold.copy(alpha=.16f)))
        Column(Modifier.padding(22.dp).align(Alignment.CenterStart)){Text("HELLO, ${name.uppercase()}",color=GoldSoft,fontSize=10.sp,fontWeight=FontWeight.Bold,letterSpacing=1.2.sp);Text("Prepare smarter.\nInterview stronger.",color=Color.White,fontSize=31.sp,lineHeight=32.sp,fontWeight=FontWeight.Black,modifier=Modifier.padding(top=10.dp));Text("Courses • Live classes • Mock tests • Daily resources",color=Color(0xFFC5D5E4),fontSize=11.sp,modifier=Modifier.padding(top=12.dp))}
    }
}

@Composable private fun SectionTitle(title:String,subtitle:String,action:String?=null,onAction:(()->Unit)?=null){Row(Modifier.fillMaxWidth().padding(18.dp,22.dp,18.dp,10.dp),verticalAlignment=Alignment.Bottom){Column(Modifier.weight(1f)){Text(title,fontSize=21.sp,fontWeight=FontWeight.Black);Text(subtitle,color=Muted,fontSize=10.sp,modifier=Modifier.padding(top=3.dp))};if(action!=null&&onAction!=null)TextButton(onClick=onAction){Text("$action →",fontSize=11.sp)}}}

@Composable private fun CategoryGrid(categories:List<Category>,onResources:()->Unit){val list=categories.take(9);Column(Modifier.padding(horizontal=14.dp)){list.chunked(3).forEach{row->Row(Modifier.fillMaxWidth()){row.forEachIndexed{i,c->Card(Modifier.weight(1f).padding(4.dp).clickable{if(c.name.contains("paper",true)||c.name.contains("mock",true))onResources()},shape=RoundedCornerShape(17.dp),colors=CardDefaults.cardColors(containerColor=Color.White),border=CardDefaults.outlinedCardBorder()){Column(Modifier.padding(14.dp).heightIn(min=84.dp),verticalArrangement=Arrangement.SpaceBetween){Text(c.icon?.takeIf{it.isNotBlank()}?:listOf("🎯","📚","🧠","📰","📄","🎥")[i%6],fontSize=21.sp);Text(c.name,fontSize=11.sp,fontWeight=FontWeight.Bold,maxLines=2)}}};repeat(3-row.size){Spacer(Modifier.weight(1f).padding(4.dp))}}}}
}

@Composable private fun CourseCard(c:Course,onClick:()->Unit){Card(Modifier.width(260.dp).clickable(onClick=onClick),shape=RoundedCornerShape(20.dp),colors=CardDefaults.cardColors(containerColor=Color.White),border=CardDefaults.outlinedCardBorder()){Column{CourseArt(Modifier.fillMaxWidth().height(125.dp),if(c.course_type=="free")"FREE LEARNING" else "INTERVIEW PREP");Column(Modifier.padding(15.dp)){Text(if(c.course_type=="free")"FREE COURSE" else "PREMIUM COURSE",color=if(c.course_type=="free")Success else Gold,fontSize=8.sp,fontWeight=FontWeight.Bold,letterSpacing=.7.sp);Text(c.title,fontWeight=FontWeight.Black,fontSize=16.sp,maxLines=2,overflow=TextOverflow.Ellipsis,modifier=Modifier.padding(top=5.dp));Text(c.short_description?:"Focused banking preparation",color=Muted,fontSize=10.sp,maxLines=2,overflow=TextOverflow.Ellipsis,modifier=Modifier.padding(top=4.dp));Row(Modifier.fillMaxWidth().padding(top=11.dp),verticalAlignment=Alignment.CenterVertically){Text(if(c.course_type=="free")"FREE" else "₹${c.price.roundToInt()}",color=if(c.course_type=="free")Success else Ink,fontWeight=FontWeight.Black);Spacer(Modifier.weight(1f));Text(if(c.purchased)"ENROLLED" else "VIEW →",color=if(c.purchased)Success else Navy,fontSize=9.sp,fontWeight=FontWeight.Bold)}}}}}

@Composable private fun CourseArt(modifier:Modifier,label:String){Box(modifier.clip(RoundedCornerShape(16.dp)).background(Brush.linearGradient(listOf(Navy2,Navy3))),contentAlignment=Alignment.Center){Column(horizontalAlignment=Alignment.CenterHorizontally){Text("GC",color=GoldSoft,fontSize=34.sp,fontWeight=FontWeight.Black);Text(label,color=Color(0xFFC9D8E6),fontSize=7.sp,fo