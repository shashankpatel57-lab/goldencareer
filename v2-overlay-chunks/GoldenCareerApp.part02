ntWeight=FontWeight.Bold,letterSpacing=1.sp,modifier=Modifier.padding(top=5.dp))}}}

@Composable private fun ContinueCard(c:HomeMiniCourse,onClick:()->Unit){val p=if(c.lessons>0)(c.completed*100/c.lessons) else 0;Card(Modifier.width(285.dp).clickable(onClick=onClick),shape=RoundedCornerShape(19.dp)){Column(Modifier.padding(17.dp)){Text("CONTINUE LEARNING",color=Gold,fontSize=8.sp,fontWeight=FontWeight.Bold,letterSpacing=.8.sp);Text(c.title,fontWeight=FontWeight.Black,fontSize=16.sp,maxLines=2,modifier=Modifier.padding(5.dp,0.dp,0.dp,10.dp));LinearProgressIndicator(progress={p/100f},modifier=Modifier.fillMaxWidth().height(6.dp).clip(CircleShape));Row(Modifier.fillMaxWidth().padding(top=7.dp)){Text("$p% complete",color=Muted,fontSize=9.sp);Spacer(Modifier.weight(1f));Text("Continue →",fontSize=9.sp,fontWeight=FontWeight.Bold)}}}}

@Composable private fun LiveCard(l:LiveClass){Card(Modifier.fillMaxWidth().padding(horizontal=18.dp,vertical=5.dp),shape=RoundedCornerShape(17.dp),colors=CardDefaults.cardColors(containerColor=Color.White)){Row(Modifier.padding(15.dp),verticalAlignment=Alignment.CenterVertically){Box(Modifier.size(10.dp).clip(CircleShape).background(if(l.status=="live")Color.Red else Gold));Spacer(Modifier.width(12.dp));Column(Modifier.weight(1f)){Text(l.title,fontWeight=FontWeight.Bold,fontSize=13.sp);Text(listOfNotNull(l.teacher,l.starts_at).joinToString(" • "),color=Muted,fontSize=9.sp,modifier=Modifier.padding(top=3.dp))};StatusBadge(l.status)}}}

@Composable private fun MyCoursesScreen(ui:AppUiState,onCourse:(Long)->Unit,onRefresh:()->Unit){when(val s=ui.myCourses){is LoadState.Error->StateError(s.message,onRefresh);is LoadState.Loading->Loading();is LoadState.Data->{val active=s.value.courses.filter{it.status=="active"};val expired=s.value.courses.filter{it.status!="active"};LazyColumn(contentPadding=PaddingValues(bottom=25.dp)){item{PageHeader("My Courses","Every enrollment from web or Android appears here automatically.")};if(active.isEmpty())item{EmptyState(Icons.Default.School,"No active courses yet","Free courses can be added from Home. Paid courses unlock immediately after server-verified payment.")};items(active){c->MyCourseCard(c){onCourse(c.id)}};if(expired.isNotEmpty())item{SectionTitle("Expired courses","Your previous learning history")};items(expired){c->MyCourseCard(c){onCourse(c.id)}}}};else->Loading()}}

@Composable private fun MyCourseCard(c:MyCourse,onClick:()->Unit){Card(Modifier.fillMaxWidth().padding(horizontal=16.dp,vertical=6.dp).clickable(onClick=onClick),shape=RoundedCornerShape(20.dp),colors=CardDefaults.cardColors(containerColor=Color.White)){Row(Modifier.padding(13.dp)){CourseArt(Modifier.size(105.dp),if(c.course_type=="free")"FREE" else "PREMIUM");Spacer(Modifier.width(14.dp));Column(Modifier.weight(1f)){Row(verticalAlignment=Alignment.CenterVertically){StatusBadge(c.status);Spacer(Modifier.width(6.dp));Text(c.instructor?:"Golden Career",color=Muted,fontSize=8.sp)};Text(c.title,fontWeight=FontWeight.Black,fontSize=16.sp,maxLines=2,modifier=Modifier.padding(top=5.dp));Text(c.last_lesson_title?.let{"Continue: $it"}?:"Open course curriculum",color=Muted,fontSize=9.sp,maxLines=1,overflow=TextOverflow.Ellipsis,modifier=Modifier.padding(top=4.dp));LinearProgressIndicator(progress={(c.progress_percent.coerceIn(0,100))/100f},modifier=Modifier.fillMaxWidth().padding(top=10.dp).height(5.dp).clip(CircleShape));Row(Modifier.fillMaxWidth().padding(top=5.dp)){Text("${c.progress_percent}% complete",fontSize=8.sp,color=Muted);Spacer(Modifier.weight(1f));Text("CONTINUE →",fontSize=8.sp,fontWeight=FontWeight.Bold,color=Navy)}}}}}

@Composable private fun LiveScreen(ui:AppUiState,onRefresh:()->Unit){when(val s=ui.live){is LoadState.Data->LazyColumn{item{PageHeader("Live Classes","Upcoming, live now and completed sessions.")};if(s.value.live_classes.isEmpty())item{EmptyState(Icons.Default.LiveTv,"No class scheduled","Your next live class will appear here automatically.")};items(s.value.live_classes){LiveCard(it)}};is LoadState.Error->StateError(s.message,onRefresh);else->Loading()}}

@Composable private fun ResourcesScreen(ui:AppUiState,onOpenLesson:(LessonSummary)->Unit,onRefresh:()->Unit){val papers=(ui.newspapers as? LoadState.Data)?.value?.newspapers.orEmpty();val mocks=(ui.mocks as? LoadState.Data)?.value?.mock_tests.orEmpty();LazyColumn(contentPadding=PaddingValues(bottom=25.dp)){item{PageHeader("Resources","Daily newspapers, mock tests and useful material.")};item{SectionTitle("Newspapers","Latest English and Hindi editions")};if(papers.isEmpty())item{EmptyState(Icons.Default.Newspaper,"No newspaper published","Admin can upload manually or use the authorized-source automation.")};items(papers.take(30)){p->PaperCard(p){p.file_id?.let{onOpenLesson(LessonSummary(id=-1,title=p.newspaper_name,lesson_type="pdf",file_id=it,locked=false))}}};item{SectionTitle("Mock Tests","Practice in banking-exam format")};if(mocks.isEmpty())item{EmptyState(Icons.Default.Quiz,"No mock tests published","Published tests will appear here.")};items(mocks){m->Card(Modifier.fillMaxWidth().padding(horizontal=16.dp,vertical=5.dp),shape=RoundedCornerShape(17.dp)){Row(Modifier.padding(16.dp),verticalAlignment=Alignment.CenterVertically){Icon(Icons.Default.Quiz,null,tint=Navy);Spacer(Modifier.width(12.dp));Column(Modifier.weight(1f)){Text(m.title,fontWeight=FontWeight.Bold,fontSize=13.sp);Text("${m.duration_minutes} min • ${m.total_marks.roundToInt()} marks • ${m.access_type.uppercase()}",color=Muted,fontSize=9.sp)};Text("OPEN",color=Gold,fontWeight=FontWeight.Bold,fontSize=9.sp)}}}}}

