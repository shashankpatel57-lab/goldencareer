7.sp,fontWeight=FontWeight.Bold,modifier=Modifier.padding(7.dp,4.dp))}}
@Composable private fun StateError(message:String,onRetry:()->Unit){Box(Modifier.fillMaxSize(),contentAlignment=Alignment.Center){Column(Modifier.padding(28.dp),horizontalAlignment=Alignment.CenterHorizontally){Icon(Icons.Default.CloudOff,null,tint=Muted,modifier=Modifier.size(42.dp));Text("Couldn't load this section",fontWeight=FontWeight.Black,fontSize=18.sp,modifier=Modifier.padding(top=12.dp));Text(message,color=Muted,fontSize=11.sp,lineHeight=16.sp,modifier=Modifier.padding(top=5.dp));Button(onClick=onRetry,modifier=Modifier.padding(top=14.dp)){Text("Retry")}}}}
@Composable private fun Loading(){Box(Modifier.fillMaxSize(),contentAlignment=Alignment.Center){CircularProgressIndicator()}}
@Composable private fun EmptyState(icon:androidx.compose.ui.graphics.vector.ImageVector,title:String,text:String){Column(Modifier.fillMaxWidth().padding(34.dp),horizontalAlignment=Alignment.CenterHorizontally){Icon(icon,null,tint=Muted,modifier=Modifier.size(38.dp));Text(title,fontWeight=FontWeight.Black,fontSize=16.sp,modifier=Modifier.padding(top=10.dp));Text(text,color=Muted,fontSize=10.sp,lineHeight=15.sp,modifier=Modifier.padding(top=5.dp),textAlign=androidx.compose.ui.text.style.TextAlign.Center)}}
