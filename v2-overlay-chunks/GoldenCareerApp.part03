ted==c.id,onClick={selected=c.id},label={Text(c.title,maxLines=1,fontSize=9.sp)})}};Spacer(Modifier.weight(1f));Surface(shadowElevation=8.dp,color=Color.White){Row(Modifier.padding(10.dp),verticalAlignment=Alignment.CenterVertically){OutlinedTextField(text,{text=it},placeholder={Text("Ask or discuss…")},modifier=Modifier.weight(1f),maxLines=3,shape=RoundedCornerShape(15.dp));IconButton(onClick={val id=selected;if(id!=null&&text.isNotBlank()){vm.sendChat(id,text);text=""}}){Icon(Icons.Default.Send,"Send",tint=Navy)}}}}}}

@Composable private fun PageHeader(title:String,subtitle:String){Column(Modifier.fillMaxWidth().padding(18.dp,22.dp,18.dp,10.dp)){Text(title,fontSize=29.sp,fontWeight=FontWeight.Black);Text(subtitle,color=Muted,fontSize=11.sp,lineHeight=16.sp,modifier=Modifier.padding(top=4.dp))}}

@Composable private fun CourseDetailScreen(state:LoadState<CourseDetailResponse>,onStartPayment:(Course,String)->Unit,onOpenLesson:(LessonSummary)->Unit,onClose:()->Unit){var coupon by remember{mutableStateOf("")};when(state){is LoadState.Loading->Loading();is LoadState.Error->StateError(state.message,onClose);is LoadState.Data->{val d=state.value;val c=d.course?:return;LazyColumn(contentPadding=PaddingValues(bottom=30.dp)){
    item{Box(Modifier.fillMaxWidth().height(230.dp).background(Brush.linearGradient(listOf(Navy,Navy3)))){Column(Modifier.align(Alignment.BottomStart).padding(20.dp)){Text(if(c.course_type=="free")"FREE COURSE" else "PREMIUM COURSE",color=GoldSoft,fontSize=9.sp,fontWeight=FontWeight.Bold,letterSpacing=1.sp);Text(c.title,color=Color.White,fontSize=29.sp,lineHeight=31.sp,fontWeight=FontWeight.Black,modifier=Modifier.padding(top=7.dp));Text(listOfNotNull(c.instructor,c.language).joinToString(" • "),color=Color(0xFFC7D7E7),fontSize=10.sp,modifier=Modifier.padding(top=7.dp))}}}
    item{Column(Modifier.padding(18.dp)){Text(c.short_description?:"Focused Golden Career learning",color=Muted,fontSize=12.sp,lineHeight=18.sp);Spacer(Modifier.height(14.dp));when{d.purchased->{Button(onClick={d.sections.flatMap{it.lessons}.firstOrNull{!it.locked}?.let(onOpenLesson)},modifier=Modifier.fillMaxWidth().height(49.dp),shape=RoundedCornerShape(14.dp)){Text("START / CONTINUE LEARNING")}};c.course_type=="free"->{Button(onClick={onStartPayment(c,"")},modifier=Modifier.fillMaxWidth().height(49.dp),shape=RoundedCornerShape(14.dp)){Text("ADD FREE COURSE TO MY COURSES")}};else->{OutlinedTextField(coupon,{coupon=it.uppercase()},label={Text("Coupon code (optional)")},modifier=Modifier.fillMaxWidth(),singleLine=true,shape=RoundedCornerShape(13.dp));Button(onClick={onStartPayment(c,coupon)},modifier=Modifier.fillMaxWidth().height(49.dp).padding(top=7.dp),shape=RoundedCornerShape(14.dp)){Text("BUY NOW • ₹${c.price.roundToInt()}")}}};if(c.course_type=="paid")Text("Premium recorded videos play in Golden Career's protected Android player. Website video remains disabled by default.",color=Muted,fontSize=9.sp,lineHeight=14.sp,modifier=Modifier.padding(top=10.dp))}}
    d.sections.forEach{sec->item{Text(sec.title,fontSize=16.sp,fontWeight=FontWeight.Black,modifier=Modifier.padding(18.dp,18.dp,18.dp,5.dp))};items(sec.lessons){l->LessonRow(l){onOpenLesson(l)}}}
    if(d.sections.isEmpty())item{EmptyState(Icons.Default.MenuBook,"Course content is being prepared","Published lessons will appear here automatically.")}
}};else->Unit}}

@Composable private fun LessonRow(l:LessonSummary,onClick:()->Unit){Row(Modifier.fillMaxWidth().clickable(enabled=!l.locked,onClick=onClick).padding(horizontal=18.dp,vertical=11.dp),verticalAlignment=Alignment.CenterVertically){Box(Modifier.size(38.dp).clip(RoundedCornerShape(11.dp)).background(if(l.locked)Color(0xFFF0F2F5) else Color(0xFFEDF4FB)),contentAlignment=Alignment.Center){Icon(when(l.lesson_type){"video"->Icons.Default.PlayCircleOutline;"pdf"->Icons.Default.PictureAsPdf;"mock_test","quiz"->Icons.Default.Quiz;else->Icons.Default.Description},null,tint=if(l.locked)Muted else Navy)};Spacer(Modifier.width(11.dp));Column(Modifier.weight(1f)){Text(l.title,fontSize=12.sp,fontWeight=FontWeight.SemiBold,color=if(l.locked)Muted else Ink);Text(if(l.is_preview)"FREE PREVIEW" else l.lesson_type.replace('_',' ').uppercase(),fontSize=8.sp,color=if(l.is_preview)Success else Muted,modifier=Modifier.padding(top=2.dp))};Icon(if(l.locked)Icons.Default.Lock else Icons.Default.ChevronRight,null,tint=Muted,modifier=Modifier.size(18.dp))}

@Composable private fun TextLessonDialog(data:LessonResponse,onComplete:()->Unit,onDismiss:()->Unit){val l=data.lesson?:return;AlertDialog(onDismissRequest=onDismiss,title={Text(l.title,fontWeight=FontWeight.Black)},text={Text(l.content?.takeIf{it.isNotBlank()}?:"This lesson has no text content yet.",fontSize=13.sp,lineHeight=20.sp)},confirmButton={Button(onClick=onComplete){Text("Mark complete")}},dismissButton={TextButton(onClick=onDismiss){Text("Close")}})}

@Composable private fun ProfileDialog(ui:AppUiState,onDismiss:()->Unit,onLogout:()->Unit){val p=(ui.profile as? LoadState.Data)?.value?.profile;AlertDialog(onDismissRequest=onDismiss,title={Text("My Profile",fontWeight=FontWeight.Black)},text={Column{Box(Modifier.size(58.dp).clip(CircleShape).background(Navy),contentAlignment=Alignment.Center){Text((p?.name?:ui.user?.name?:"S").take(1).uppercase(),color=GoldSoft,fontSize=22.sp,fontWeight=FontWeight.Black)};Text(p?.name?:ui.user?.name?:"Student",fontSize=20.sp,fontWeight=FontWeight.Black,modifier=Modifier.padding(top=12.dp));Text(p?.email?:ui.user?.email?:"",color=Muted,fontSize=11.sp);p?.mobile?.let{Text(it,color=Muted,fontSize=11.sp)};HorizontalDivider(Modifier.padding(vertical=14.dp));Text("One account across web + Android",fontWeight=FontWeight.Bold,fontSize=11.sp);Text("Purchased courses, progress and authorized resources stay linked to this account.",color=Muted,fontSize=10.sp,lineHeight=15.sp,modifier=Modifier.padding(top=5.dp))}},confirmButton={Button(onClick=onLogout){Text("Logout")}},dismissButton={TextButton(onClick=onDismiss){Text("Close")}})}

@Composable private fun NotificationsDialog(ui:AppUiState,onDismiss:()->Unit){val n=(ui.notifications as? LoadState.Data)?.value?.notifications.orEmpty();AlertDialog(onDismissRequest=onDismiss,title={Text("Notifications",fontWeight=FontWeight.Black)},text={LazyColumn(Modifier.heightIn(max=420.dp)){if(n.isEmpty())item{Text("No notifications yet.",color=Muted)}else items(n){x->Column(Modifier.padding(vertical=9.dp)){Text(x.title,fontWeight=FontWeight.Bold,fontSize=12.sp);Text(x.body,color=Muted,fontSize=10.sp,lineHeight=14.sp);HorizontalDivider(Modifier.padding(top=9.dp))}}}},confirmButton={TextButton(onClick=onDismiss){Text("Close")}})}

@Composable private fun StatusBadge(status:String){Surface(shape=CircleShape,color=when(status){"active","live","published"->Color(0xFFE7F7F1);"expired","failed"->Color(0xFFFFECEB);else->Color(0xFFFFF5E2)}){Text(status.uppercase(),color=when(status){"active","live","published"->Success;"expired","failed"->Danger;else->Color(0xFF9A6812)},fontSize=